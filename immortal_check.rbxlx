          <string name="Name">SkillConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
    SkillConfig.luau
    Central configuration for all 6 combat skills.
    Defines cooldowns, base damage, ranges, targeting behaviors, and metadata.
]]

export type SkillType = "ForwardProjectile" | "AreaAroundCaster" | "TargetAreaAoE" | "SkyStrikeAoE" | "MultiProjectile" | "LockOnHoming"

export type SkillDefinition = {
	Name: string,
	DisplayName: string,
	Description: string,
	SkillType: SkillType,
	BaseDamage: number,
	Cooldown: number,
	Range: number,
	Radius: number?,
	ProjectileSpeed: number?,
	ProjectileCount: number?,
	CastTime: number?,
	WarningDuration: number?,
	Color: Color3,
	SecondaryColor: Color3,
	IconSymbol: string,
}

local SkillConfig: { [string]: SkillDefinition } = {
	["Sword Slash"] = {
		Name = "Sword Slash",
		DisplayName = "Wind Blade Slash",
		Description = "Performs a swift crescent slash, launching a razor-sharp blade of pressurized wind forward 20 studs.",
		SkillType = "ForwardProjectile",
		BaseDamage = 28,
		Cooldown = 3.5,
		Range = 25,
		Radius = 4,
		ProjectileSpeed = 70,
		CastTime = 0.25,
		Color = Color3.fromRGB(120, 235, 210), -- Cyan-Teal wind
		SecondaryColor = Color3.fromRGB(240, 255, 255),
		IconSymbol = "🗡️",
	},

	["Palm Art"] = {
		Name = "Palm Art",
		DisplayName = "Vajra Energy Palm",
		Description = "Focuses inner Qi into the palm, unleashing an immense golden shockwave hand that blasts all nearby enemies.",
		SkillType = "AreaAroundCaster",
		BaseDamage = 38,
		Cooldown = 4.0,
		Range = 14,
		Radius = 12,
		CastTime = 0.2,
		Color = Color3.fromRGB(255, 205, 50), -- Golden Qi
		SecondaryColor = Color3.fromRGB(255, 120, 30),
		IconSymbol = "✋",
	},

	["Flame Ball"] = {
		Name = "Flame Ball",
		DisplayName = "Blazing Lotus Orb",
		Description = "Condenses fire spirit energy into an explosive sphere and hurls it toward the targeted location.",
		SkillType = "TargetAreaAoE",
		BaseDamage = 45,
		Cooldown = 5.0,
		Range = 60,
		Radius = 14,
		ProjectileSpeed = 65,
		CastTime = 0.3,
		Color = Color3.fromRGB(255, 95, 25), -- Crimson Flame
		SecondaryColor = Color3.fromRGB(255, 215, 60),
		IconSymbol = "🔥",
	},

	["Thunder Strike"] = {
		Name = "Thunder Strike",
		DisplayName = "Heavenly Nine-Thunder",
		Description = "Calls down lightning from the heavens onto a targeted zone after a brief warning talisman circle.",
		SkillType = "SkyStrikeAoE",
		BaseDamage = 58,
		Cooldown = 6.0,
		Range = 65,
		Radius = 15,
		CastTime = 0.15,
		WarningDuration = 0.65,
		Color = Color3.fromRGB(130, 180, 255), -- Azure Lightning
		SecondaryColor = Color3.fromRGB(230, 245, 255),
		IconSymbol = "⚡",
	},

	["Multiple Swords"] = {
		Name = "Multiple Swords",
		DisplayName = "Myriad Flying Swords",
		Description = "Summons 5 floating astral spirit swords in a radiant halo, launching them in rapid succession at the enemy.",
		SkillType = "MultiProjectile",
		BaseDamage = 14, -- 14 * 5 = 70 max total
		Cooldown = 6.5,
		Range = 65,
		Radius = 3.5,
		ProjectileSpeed = 90,
		ProjectileCount = 5,
		CastTime = 0.35,
		Color = Color3.fromRGB(175, 110, 255), -- Mystic Purple
		SecondaryColor = Color3.fromRGB(235, 190, 255),
		IconSymbol = "⚔️",
	},

	["Flame Spear"] = {
		Name = "Flame Spear",
		DisplayName = "Solar Dragon Javelin",
		Description = "Locks onto a target enemy, forging a superheated solar lance that seeks and pierces the victim.",
		SkillType = "LockOnHoming",
		BaseDamage = 50,
		Cooldown = 7.0,
		Range = 60,
		Radius = 6,
		ProjectileSpeed = 80,
		CastTime = 0.3,
		Color = Color3.fromRGB(255, 60, 20), -- Intense Solar Fire
		SecondaryColor = Color3.fromRGB(255, 240, 100),
		IconSymbol = "🔱",
	},
}

-- Ordered list of all available skill names
local SkillList: { string } = {
	"Sword Slash",
	"Palm Art",
	"Flame Ball",
	"Thunder Strike",
	"Multiple Swords",
	"Flame Spear",
}

-- Default 4 skills assigned to slots 1-4 (Z, X, V, F)
local DefaultSlots: { [number]: string } = {
	[1] = "Sword Slash",
	[2] = "Palm Art",
	[3] = "Flame Ball",
	[4] = "Thunder Strike",
}

return {
	Skills = SkillConfig,
	SkillList = SkillList,
	DefaultSlots = DefaultSlots,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">SkillFXHelper</string>
          <string name="Source"><![CDATA[--!strict
--[[
    SkillFXHelper.luau
    Client-side visual and sound effects generator for all anime combat skills.
    Procedurally creates high-quality anime VFX:
    - Glowing neon meshes, slash arcs, wind blades, trails
    - Energy palm shockwave bursts, ground magic circles
    - Lightning bolts from sky, fireball impacts, flying spirit swords, solar spear
    - Dynamic camera shakes on high-impact hits
]]

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local SkillFXHelper = {}

local camera = Workspace.CurrentCamera
local localPlayer = Players.LocalPlayer

-- Camera Shake Effect
function SkillFXHelper.shakeCamera(intensity: number, duration: number)
	if not camera then return end
	task.spawn(function()
		local startTime = tick()
		local origCFrame = camera.CFrame
		while tick() - startTime < duration do
			local elapsed = tick() - startTime
			local currentIntensity = intensity * (1 - (elapsed / duration))
			local shakeOffset = Vector3.new(
				(math.random() - 0.5) * currentIntensity,
				(math.random() - 0.5) * currentIntensity,
				(math.random() - 0.5) * currentIntensity
			)
			camera.CFrame = camera.CFrame * CFrame.new(shakeOffset)
			task.wait(0.02)
		end
	end)
end

-- Procedural Sound Creator
function SkillFXHelper.playSound(parent: Instance, soundId: string, volume: number, pitch: number, lifetime: number)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	sound.RollOffMaxDistance = 150
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, lifetime or 2)
	return sound
end

--------------------------------------------------------------------------------
-- 1. SWORD SLASH VFX (Crescent Wind Blade + Air Trails)
--------------------------------------------------------------------------------
function SkillFXHelper.playSwordSlash(casterChar: Model, startPos: Vector3, direction: Vector3, range: number, speed: number)
	-- Sound
	local root = casterChar:FindFirstChild("HumanoidRootPart")
	if root then
		SkillFXHelper.playSound(root, "rbxassetid://9114223175", 0.8, 1.2, 1.5) -- Swift sword whoosh
	end

	-- Wind Blade Crescent Model
	local blade = Instance.new("Part")
	blade.Name = "WindBlade"
	blade.Size = Vector3.new(5, 0.4, 2.5)
	blade.CFrame = CFrame.lookAt(startPos, startPos + direction) * CFrame.Angles(0, 0, math.rad(45))
	blade.Material = Enum.Material.Neon
	blade.Color = Color3.fromRGB(130, 240, 220)
	blade.CanCollide = false
	blade.Anchored = true
	blade.CastShadow = false

	-- Special Mesh for sharp crescent shape
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 0.15, 0.6)
	mesh.Parent = blade

	-- Inner Glow Blade
	local inner = Instance.new("Part")
	inner.Name = "InnerCore"
	inner.Size = Vector3.new(3.5, 0.2, 1.8)
	inner.CFrame = blade.CFrame
	inner.Material = Enum.Material.Neon
	inner.Color = Color3.fromRGB(255, 255, 255)
	inner.CanCollide = false
	inner.Anchored = true
	inner.CastShadow = false
	inner.Parent = blade

	-- Trail Attachment
	local att0 = Instance.new("Attachment", blade)
	att0.Position = Vector3.new(-2.5, 0, 0)
	local att1 = Instance.new("Attachment", blade)
	att1.Position = Vector3.new(2.5, 0, 0)

	local trail = Instance.new("Trail")
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 255, 235), Color3.fromRGB(80, 200, 180))
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Lifetime = 0.2
	trail.Parent = blade

	-- Particles
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(160, 255, 240), Color3.fromRGB(255, 255, 255))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.15, 0.3)
	pe.Rate = 50
	pe.Speed = NumberRange.new(2, 6)
	pe.SpreadAngle = Vector2.new(45, 45)
	pe.Parent = blade

	blade.Parent = Workspace

	local travelDist = range or 22
	local travelTime = travelDist / (speed or 70)
	local targetPos = startPos + direction * travelDist

	local tween = TweenService:Create(blade, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
		CFrame = CFrame.lookAt(targetPos, targetPos + direction) * CFrame.Angles(0, 0, math.rad(45))
	})
	tween:Play()

	-- Keep inner core aligned
	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < travelTime and blade.Parent do
			inner.CFrame = blade.CFrame
			task.wait(0.02)
		end

		-- Burst impact on reach
		pe.Rate = 0
		local burst = Instance.new("ParticleEmitter")
		burst.Color = ColorSequence.new(Color3.fromRGB(180, 255, 245))
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0) })
		burst.Speed = NumberRange.new(10, 20)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Lifetime = NumberRange.new(0.2, 0.4)
		burst.Parent = blade
		burst:Emit(25)

		TweenService:Create(blade, TweenInfo.new(0.2), { Transparency = 1 }):Play()
		TweenService:Create(inner, TweenInfo.new(0.2), { Transparency = 1 }):Play()
		task.wait(0.25)
		blade:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 2. PALM ART VFX (Vajra Energy Palm Shockwave + Ground Ring)
--------------------------------------------------------------------------------
function SkillFXHelper.playPalmArt(casterChar: Model, originPos: Vector3, lookDir: Vector3, radius: number)
	local root = casterChar:FindFirstChild("HumanoidRootPart")
	if root then
		SkillFXHelper.playSound(root, "rbxassetid://9114223689", 1.0, 0.9, 2.0) -- Heavy energy blast
	end

	-- Giant Glowing Energy Palm Shape
	local palmModel = Instance.new("Model")
	palmModel.Name = "EnergyPalmVFX"

	-- Main Palm Disc / Hand
	local palm = Instance.new("Part")
	palm.Name = "PalmCore"
	palm.Size = Vector3.new(1, 1, 1)
	palm.CFrame = CFrame.lookAt(originPos + lookDir * 4, originPos + lookDir * 15) * CFrame.Angles(math.rad(90), 0, 0)
	palm.Material = Enum.Material.Neon
	palm.Color = Color3.fromRGB(255, 210, 50)
	palm.CanCollide = false
	palm.Anchored = true
	palm.CastShadow = false

	local pMesh = Instance.new("SpecialMesh")
	pMesh.MeshType = Enum.MeshType.Cylinder
	pMesh.Scale = Vector3.new(0.2, 4, 6)
	pMesh.Parent = palm
	palm.Parent = palmModel

	-- Energy Shockwave Ring
	local ring = Instance.new("Part")
	ring.Name = "ShockRing"
	ring.Size = Vector3.new(2, 0.2, 2)
	ring.CFrame = CFrame.new(originPos)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 140, 30)
	ring.CanCollide = false
	ring.Anchored = true
	ring.CastShadow = false
	ring.Parent = palmModel

	local rMesh = Instance.new("SpecialMesh")
	rMesh.MeshType = Enum.MeshType.Sphere
	rMesh.Scale = Vector3.new(1, 0.1, 1)
	rMesh.Parent = ring

	-- Golden Qi Particles
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 100, 20))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.0), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.25, 0.5)
	pe.Speed = NumberRange.new(15, 30)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Parent = palm
	pe:Emit(35)

	palmModel.Parent = Workspace

	-- Camera Shake
	if localPlayer.Character and (localPlayer.Character:GetPivot().Position - originPos).Magnitude < 35 then
		SkillFXHelper.shakeCamera(0.8, 0.3)
	end

	-- Expand and Blast Forward
	local forwardTarget = palm.CFrame + lookDir * 12
	local palmTween = TweenService:Create(palm, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
		CFrame = forwardTarget,
		Transparency = 0.9,
	})
	local meshTween = TweenService:Create(pMesh, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
		Scale = Vector3.new(0.4, 14, 18),
	})
	local ringTween = TweenService:Create(rMesh, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = Vector3.new(radius * 2, 0.1, radius * 2),
	})
	local ringAlpha = TweenService:Create(ring, TweenInfo.new(0.4), { Transparency = 1 })

	palmTween:Play()
	meshTween:Play()
	ringTween:Play()
	ringAlpha:Play()

	task.delay(0.45, function()
		palmModel:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 3. FLAME BALL VFX (Hurlable Fire Sphere + Explosive Scorch Impact)
--------------------------------------------------------------------------------
function SkillFXHelper.playFlameBall(casterChar: Model, startPos: Vector3, targetPos: Vector3, speed: number, radius: number)
	local root = casterChar:FindFirstChild("HumanoidRootPart")
	if root then
		SkillFXHelper.playSound(root, "rbxassetid://9114223805", 0.9, 1.1, 2.0) -- Fire launch sound
	end

	local ball = Instance.new("Part")
	ball.Name = "FlameBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(3, 3, 3)
	ball.Position = startPos
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 90, 20)
	ball.CanCollide = false
	ball.Anchored = true
	ball.CastShadow = false

	-- Fire Particle Core
	local fire = Instance.new("Fire")
	fire.Size = 8
	fire.Heat = 15
	fire.Color = Color3.fromRGB(255, 120, 30)
	fire.SecondaryColor = Color3.fromRGB(255, 230, 80)
	fire.Parent = ball

	-- Sparks & Embers
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 200, 50), Color3.fromRGB(200, 30, 10))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.2, 0.4)
	pe.Rate = 60
	pe.Speed = NumberRange.new(5, 12)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = ball

	ball.Parent = Workspace

	local dist = (targetPos - startPos).Magnitude
	local flightTime = dist / (speed or 65)

	local tween = TweenService:Create(ball, TweenInfo.new(flightTime, Enum.EasingStyle.Linear), {
		Position = targetPos
	})
	tween:Play()

	task.delay(flightTime, function()
		ball.Transparency = 1
		fire.Enabled = false
		pe.Rate = 0

		-- Explosion VFX at Target
		SkillFXHelper.playSound(ball, "rbxassetid://9114224027", 1.0, 1.0, 2.5) -- Fiery explosion

		-- Shockwave Sphere
		local blast = Instance.new("Part")
		blast.Shape = Enum.PartType.Ball
		blast.Size = Vector3.new(2, 2, 2)
		blast.Position = targetPos
		blast.Material = Enum.Material.Neon
		blast.Color = Color3.fromRGB(255, 140, 40)
		blast.CanCollide = false
		blast.Anchored = true
		blast.Parent = Workspace

		local blastTween = TweenService:Create(blast, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(radius * 2, radius * 2, radius * 2),
			Transparency = 1,
		})
		blastTween:Play()

		-- Radial Fire Particles
		local burstPe = Instance.new("ParticleEmitter")
		burstPe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 70), Color3.fromRGB(255, 50, 10))
		burstPe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.0), NumberSequenceKeypoint.new(1, 0) })
		burstPe.Lifetime = NumberRange.new(0.4, 0.7)
		burstPe.Speed = NumberRange.new(18, 35)
		burstPe.SpreadAngle = Vector2.new(180, 180)
		burstPe.Parent = blast
		burstPe:Emit(50)

		-- Screen shake if near
		if localPlayer.Character and (localPlayer.Character:GetPivot().Position - targetPos).Magnitude < 40 then
			SkillFXHelper.shakeCamera(1.0, 0.35)
		end

		task.wait(0.7)
		blast:Destroy()
		ball:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 4. THUNDER STRIKE VFX (Warning Seal + Sky Lightning Bolt)
--------------------------------------------------------------------------------
function SkillFXHelper.playThunderStrike(targetPos: Vector3, radius: number, warningDuration: number)
	-- 1. Ground Warning Talisman Ring
	local warningRing = Instance.new("Part")
	warningRing.Name = "LightningSeal"
	warningRing.Size = Vector3.new(1, 0.05, 1)
	warningRing.CFrame = CFrame.new(targetPos + Vector3.new(0, 0.1, 0))
	warningRing.Material = Enum.Material.Neon
	warningRing.Color = Color3.fromRGB(120, 180, 255)
	warningRing.CanCollide = false
	warningRing.Anchored = true
	warningRing.CastShadow = false

	local wMesh = Instance.new("SpecialMesh")
	wMesh.MeshType = Enum.MeshType.Cylinder
	wMesh.Scale = Vector3.new(0.1, radius * 2, radius * 2)
	wMesh.Parent = warningRing

	-- Crackling Electricity Particles on Ground
	local groundElec = Instance.new("ParticleEmitter")
	groundElec.Color = ColorSequence.new(Color3.fromRGB(180, 220, 255), Color3.fromRGB(255, 255, 255))
	groundElec.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	groundElec.Lifetime = NumberRange.new(0.15, 0.3)
	groundElec.Rate = 25
	groundElec.Speed = NumberRange.new(3, 8)
	groundElec.SpreadAngle = Vector2.new(180, 0)
	groundElec.Parent = warningRing

	warningRing.Parent = Workspace

	-- Pulse Warning
	local pulseTween = TweenService:Create(wMesh, TweenInfo.new(warningDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = Vector3.new(0.2, radius * 2.2, radius * 2.2),
	})
	pulseTween:Play()

	task.delay(warningDuration, function()
		groundElec.Rate = 0
		warningRing:Destroy()

		-- 2. Heavenly Lightning Strike from Sky (Y = +120)
		local skyY = targetPos.Y + 110
		local boltHeight = 110

		local bolt = Instance.new("Part")
		bolt.Name = "ThunderBolt"
		bolt.Size = Vector3.new(3, boltHeight, 3)
		bolt.Position = Vector3.new(targetPos.X, targetPos.Y + (boltHeight / 2), targetPos.Z)
		bolt.Material = Enum.Material.Neon
		bolt.Color = Color3.fromRGB(210, 235, 255)
		bolt.CanCollide = false
		bolt.Anchored = true
		bolt.CastShadow = false
		bolt.Parent = Workspace

		-- Inner Core Bolt
		local innerBolt = Instance.new("Part")
		innerBolt.Size = Vector3.new(1.2, boltHeight, 1.2)
		innerBolt.Position = bolt.Position
		innerBolt.Material = Enum.Material.Neon
		innerBolt.Color = Color3.fromRGB(255, 255, 255)
		innerBolt.CanCollide = false
		innerBolt.Anchored = true
		innerBolt.CastShadow = false
		innerBolt.Parent = Workspace

		-- Thunder Sound
		SkillFXHelper.playSound(bolt, "rbxassetid://9114224158", 1.2, 0.95, 3.0) -- Thunderclap

		-- Radial Electric Flash Ground Burst
		local elecBurst = Instance.new("ParticleEmitter")
		elecBurst.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255), Color3.fromRGB(255, 255, 255))
		elecBurst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 0) })
		elecBurst.Speed = NumberRange.new(20, 45)
		elecBurst.SpreadAngle = Vector2.new(180, 180)
		elecBurst.Lifetime = NumberRange.new(0.2, 0.45)
		elecBurst.Parent = bolt
		elecBurst:Emit(60)

		-- Heavy Camera Shake
		if localPlayer.Character and (localPlayer.Character:GetPivot().Position - targetPos).Magnitude < 60 then
			SkillFXHelper.shakeCamera(1.5, 0.4)
		end

		-- Fast fade out
		local fade1 = TweenService:Create(bolt, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.new(6, boltHeight, 6) })
		local fade2 = TweenService:Create(innerBolt, TweenInfo.new(0.2), { Transparency = 1, Size = Vector3.new(3, boltHeight, 3) })
		fade1:Play()
		fade2:Play()

		task.wait(0.3)
		bolt:Destroy()
		innerBolt:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 5. MULTIPLE SWORDS VFX (Summon Halo + Sequential Firing)
--------------------------------------------------------------------------------
function SkillFXHelper.playMultipleSwords(casterChar: Model, startOrigin: Vector3, targetPos: Vector3, count: number, speed: number)
	local root = casterChar:FindFirstChild("HumanoidRootPart")
	if not root then return end

	SkillFXHelper.playSound(root, "rbxassetid://9114224300", 0.9, 1.1, 2.5) -- Sword summon chime

	local swords: { Part } = {}
	local total = count or 5

	-- Arc positions behind and above caster
	for i = 1, total do
		local angle = math.rad(-70 + ((i - 1) / (total - 1)) * 140)
		local xOff = math.sin(angle) * 3.5
		local yOff = 2.5 + math.cos(angle) * 1.2
		local zOff = 2.0

		local sword = Instance.new("Part")
		sword.Name = "SpiritSword_" .. i
		sword.Size = Vector3.new(0.4, 4.2, 0.8)
		sword.Material = Enum.Material.Neon
		sword.Color = Color3.fromRGB(180, 120, 255)
		sword.CanCollide = false
		sword.Anchored = true
		sword.CastShadow = false

		-- Glowing Mesh
		local sMesh = Instance.new("SpecialMesh")
		sMesh.MeshType = Enum.MeshType.Brick
		sMesh.Scale = Vector3.new(0.8, 1, 0.8)
		sMesh.Parent = sword

		-- Sword Trail
		local a0 = Instance.new("Attachment", sword)
		a0.Position = Vector3.new(0, -2, 0)
		local a1 = Instance.new("Attachment", sword)
		a1.Position = Vector3.new(0, 2, 0)

		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(200, 150, 255), Color3.fromRGB(120, 60, 220))
		trail.Lifetime = 0.2
		trail.Parent = sword

		-- Aim pointing toward target
		sword.CFrame = root.CFrame * CFrame.new(xOff, yOff, zOff) * CFrame.Angles(math.rad(-90), 0, 0)
		sword.Parent = Workspace
		table.insert(swords, sword)
	end

	-- Sequentially launch each sword with a small delay
	task.spawn(function()
		for idx, sword in ipairs(swords) do
			task.wait(0.08)
			if not sword.Parent then continue end

			SkillFXHelper.playSound(sword, "rbxassetid://9114223175", 0.5, 1.4 + (idx * 0.1), 1.0) -- Swift launch

			local curPos = sword.Position
			local dest = targetPos + Vector3.new((math.random() - 0.5) * 2, (math.random() - 0.5) * 2, (math.random() - 0.5) * 2)
			local dist = (dest - curPos).Magnitude
			local travelTime = dist / (speed or 90)

			local tween = TweenService:Create(sword, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
				CFrame = CFrame.lookAt(dest, dest + (dest - curPos)) * CFrame.Angles(math.rad(-90), 0, 0)
			})
			tween:Play()

			task.delay(travelTime, function()
				if sword.Parent then
					local impactPe = Instance.new("ParticleEmitter")
					impactPe.Color = ColorSequence.new(Color3.fromRGB(220, 170, 255))
					impactPe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
					impactPe.Speed = NumberRange.new(8, 16)
					impactPe.SpreadAngle = Vector2.new(180, 180)
					impactPe.Lifetime = NumberRange.new(0.2, 0.35)
					impactPe.Parent = sword
					impactPe:Emit(15)

					sword.Transparency = 1
					task.wait(0.2)
					sword:Destroy()
				end
			end)
		end
	end)
end

--------------------------------------------------------------------------------
-- 6. FLAME SPEAR VFX (Solar Dragon Javelin + Homing Guide Beam)
--------------------------------------------------------------------------------
function SkillFXHelper.playFlameSpear(casterChar: Model, startPos: Vector3, targetModel: Model?, targetStaticPos: Vector3, speed: number)
	local root = casterChar:FindFirstChild("HumanoidRootPart")
	if root then
		SkillFXHelper.playSound(root, "rbxassetid://9114224444", 1.0, 1.0, 2.5) -- High-energy spear release
	end

	local spear = Instance.new("Part")
	spear.Name = "SolarFlameSpear"
	spear.Size = Vector3.new(0.6, 0.6, 7.0)
	spear.Position = startPos
	spear.Material = Enum.Material.Neon
	spear.Color = Color3.fromRGB(255, 80, 20)
	spear.CanCollide = false
	spear.Anchored = true
	spear.CastShadow = false

	-- Flame Trail
	local a0 = Instance.new("Attachment", spear)
	a0.Position = Vector3.new(0, 0, -3.5)
	local a1 = Instance.new("Attachment", spear)
	a1.Position = Vector3.new(0, 0, 3.5)

	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 230, 80), Color3.fromRGB(255, 40, 10))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.Lifetime = 0.35
	trail.Parent = spear

	-- Solar Flare Particles
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 80, 10))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0) })
	pe.Speed = NumberRange.new(8, 15)
	pe.Rate = 60
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.Parent = spear

	spear.Parent = Workspace

	-- Guided Homing Simulation
	task.spawn(function()
		local curPos = startPos
		local maxSteps = 45
		local stepDuration = 0.03
		local step = 0

		while step < maxSteps and spear.Parent do
			step = step + 1
			task.wait(stepDuration)

			-- Recalculate target position if target is a live enemy
			local dest = targetStaticPos
			if targetModel and targetModel.Parent then
				local tRoot = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso")
				if tRoot and tRoot:IsA("BasePart") then
					dest = tRoot.Position
				end
			end

			local toDest = dest - curPos
			local dist = toDest.Magnitude
			local moveStep = math.min((speed or 80) * stepDuration, dist)
			local nextPos = curPos + toDest.Unit * moveStep

			spear.CFrame = CFrame.lookAt(nextPos, dest)
			curPos = nextPos

			if dist <= 2.5 then
				break
			end
		end

		-- Explosion on contact
		if spear.Parent then
			SkillFXHelper.playSound(spear, "rbxassetid://9114224027", 1.1, 1.2, 2.0)
			pe.Rate = 0

			local impactBurst = Instance.new("ParticleEmitter")
			impactBurst.Color = ColorSequence.new(Color3.fromRGB(255, 240, 100), Color3.fromRGB(255, 40, 10))
			impactBurst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.5), NumberSequenceKeypoint.new(1, 0) })
			impactBurst.Speed = NumberRange.new(20, 40)
			impactBurst.SpreadAngle = Vector2.new(180, 180)
			impactBurst.Lifetime = NumberRange.new(0.3, 0.6)
			impactBurst.Parent = spear
			impactBurst:Emit(45)

			spear.Transparency = 1
			if localPlayer.Character and (localPlayer.Character:GetPivot().Position - curPos).Magnitude < 40 then
				SkillFXHelper.shakeCamera(1.2, 0.3)
			end

			task.wait(0.35)
			spear:Destroy()
		end
	end)
end

return SkillFXHelper
