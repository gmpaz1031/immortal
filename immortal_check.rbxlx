		nameLbl.TextColor3 = Color3.fromRGB(220, 225, 235)
		nameLbl.TextScaled = true
		nameLbl.Parent = slotFrame
		slotSkillNameTexts[slotIdx] = nameLbl

		-- Keybind Badge (Top-Left)
		local keyBadge = Instance.new("TextLabel")
		keyBadge.Name = "KeyBadge"
		keyBadge.Size = UDim2.new(0, 20, 0, 20)
		keyBadge.Position = UDim2.new(0, 4, 0, 4)
		keyBadge.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
		keyBadge.Font = Enum.Font.GothamBlack
		keyBadge.Text = slotKeyNames[slotIdx]
		keyBadge.TextColor3 = Color3.fromRGB(255, 215, 80)
		keyBadge.TextSize = 12
		keyBadge.Parent = slotFrame

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 4)
		bCorner.Parent = keyBadge

		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(90, 80, 50)
		bStroke.Thickness = 1
		bStroke.Parent = keyBadge
		slotKeyBadges[slotIdx] = keyBadge

		-- Cooldown Dark Overlay
		local cdOverlay = Instance.new("Frame")
		cdOverlay.Name = "CooldownOverlay"
		cdOverlay.BackgroundColor3 = Color3.fromRGB(5, 5, 8)
		cdOverlay.BackgroundTransparency = 0.4
		cdOverlay.BorderSizePixel = 0
		cdOverlay.Size = UDim2.new(1, 0, 0, 0)
		cdOverlay.Position = UDim2.new(0, 0, 1, 0)
		cdOverlay.AnchorPoint = Vector2.new(0, 1)
		cdOverlay.Visible = false
		cdOverlay.Parent = slotFrame

		local cdCorner = Instance.new("UICorner")
		cdCorner.CornerRadius = UDim.new(0, 10)
		cdCorner.Parent = cdOverlay
		slotCooldownFrames[slotIdx] = cdOverlay

		-- Cooldown Timer Number
		local cdText = Instance.new("TextLabel")
		cdText.Name = "CooldownText"
		cdText.BackgroundTransparency = 1
		cdText.Size = UDim2.new(1, 0, 1, 0)
		cdText.Font = Enum.Font.GothamBlack
		cdText.Text = ""
		cdText.TextColor3 = Color3.fromRGB(255, 255, 255)
		cdText.TextSize = 22
		cdText.Visible = false
		cdText.Parent = slotFrame
		slotCooldownTexts[slotIdx] = cdText

		-- Click slot to trigger skill as alternative to keybind
		local clickBtn = Instance.new("TextButton")
		clickBtn.Name = "ClickHitbox"
		clickBtn.BackgroundTransparency = 1
		clickBtn.Size = UDim2.new(1, 0, 1, 0)
		clickBtn.Text = ""
		clickBtn.Parent = slotFrame

		clickBtn.MouseButton1Click:Connect(function()
			activateSlot(slotIdx)
		end)

		slotUIButtons[slotIdx] = slotFrame
	end
end

local function refreshHotbarUI()
	for slotIdx = 1, 4 do
		local skillName = equippedSlots[slotIdx]
		local skillDef = SkillConfig.Skills[skillName]

		if skillDef then
			slotSkillNameTexts[slotIdx].Text = skillDef.Name
			slotIconLabels[slotIdx].Text = skillDef.IconSymbol
			local stroke = slotUIButtons[slotIdx]:FindFirstChild("SlotStroke") :: UIStroke?
			if stroke then
				stroke.Color = skillDef.Color
			end
		else
			slotSkillNameTexts[slotIdx].Text = "[Empty]"
			slotIconLabels[slotIdx].Text = "➕"
			local stroke = slotUIButtons[slotIdx]:FindFirstChild("SlotStroke") :: UIStroke?
			if stroke then
				stroke.Color = Color3.fromRGB(55, 60, 80)
			end
		end
	end
end

