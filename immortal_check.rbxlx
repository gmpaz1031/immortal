local function renderModalSlotBar()
	for slot = 1, 4 do
		local btn = modalSlotBtns[slot]
		if not btn then
			btn = Instance.new("TextButton")
			btn.Name = "SlotBtn_" .. slot
			btn.Size = UDim2.new(0, 142, 0, 42)
			btn.Position = UDim2.new(0, 6 + (slot - 1) * 152, 0, 5)
			btn.BorderSizePixel = 0
			btn.Parent = modalSlotBar

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = btn

			local s = Instance.new("UIStroke")
			s.Name = "BtnStroke"
			s.Thickness = 1.5
			s.Parent = btn

			btn.MouseButton1Click:Connect(function()
				activeSelectSlot = slot
				renderModalSlotBar()
			end)

			modalSlotBtns[slot] = btn
		end

		local skillName = equippedSlots[slot]
		local isCurrent = (activeSelectSlot == slot)
		local stroke = btn:FindFirstChild("BtnStroke") :: UIStroke?

		if isCurrent then
			btn.BackgroundColor3 = Color3.fromRGB(45, 55, 80)
			if stroke then stroke.Color = Color3.fromRGB(255, 215, 80) end
		else
			btn.BackgroundColor3 = Color3.fromRGB(26, 30, 42)
			if stroke then stroke.Color = Color3.fromRGB(60, 65, 85) end
		end

		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = isCurrent and Color3.fromRGB(255, 230, 130) or Color3.fromRGB(200, 205, 220)
		btn.Text = string.format("[%s] %s", slotKeyNames[slot], skillName ~= "" and skillName or "Empty")
	end
end

local function renderSkillList()
	for _, child in ipairs(skillScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	for _, skillName in ipairs(SkillConfig.SkillList) do
		local def = SkillConfig.Skills[skillName]
		if not def then continue end

		-- Check if currently equipped in any slot
		local equippedInSlot = nil
		for s = 1, 4 do
			if equippedSlots[s] == skillName then
				equippedInSlot = s
				break
			end
		end

		local item = Instance.new("Frame")
		item.Name = "SkillItem_" .. skillName
		item.Size = UDim2.new(1, -8, 0, 60)
		item.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
		item.BorderSizePixel = 0
		item.Parent = skillScroll

		local iCorner = Instance.new("UICorner")
		iCorner.CornerRadius = UDim.new(0, 8)
		iCorner.Parent = item

		local iStroke = Instance.new("UIStroke")
		iStroke.Color = def.Color
		iStroke.Thickness = 1.2
		iStroke.Parent = item

		-- Icon
		local iconLbl = Instance.new("TextLabel")
		iconLbl.BackgroundTransparency = 1
		iconLbl.Position = UDim2.new(0, 10, 0, 8)
		iconLbl.Size = UDim2.new(0, 44, 0, 44)
		iconLbl.Text = def.IconSymbol
		iconLbl.TextSize = 32
		iconLbl.Parent = item

		-- Name & Type
		local nameLbl = Instance.new("TextLabel")
		nameLbl.BackgroundTransparency = 1
		nameLbl.Position = UDim2.new(0, 62, 0, 8)
		nameLbl.Size = UDim2.new(0, 260, 0, 20)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.Text = def.DisplayName .. " (" .. def.Name .. ")"
		nameLbl.TextColor3 = def.Color
		nameLbl.TextSize = 14
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.Parent = item

		-- Stats info (Damage & Cooldown)
		local statsLbl = Instance.new("TextLabel")
		statsLbl.BackgroundTransparency = 1
		statsLbl.Position = UDim2.new(0, 62, 0, 30)
		statsLbl.Size = UDim2.new(0, 360, 0, 20)
		statsLbl.Font = Enum.Font.Gotham
		statsLbl.Text = string.format("⚔️ Base Dmg: %d   ⏱️ CD: %.1fs   🎯 Range: %d studs", def.BaseDamage, def.Cooldown, def.Range)
		statsLbl.TextColor3 = Color3.fromRGB(160, 165, 180)
		statsLbl.TextSize = 12
		statsLbl.TextXAlignment = Enum.TextXAlignment.Left
		statsLbl.Parent = item

		-- Equip / Assigned Button
		local actionBtn = Instance.new("TextButton")
		actionBtn.AnchorPoint = Vector2.new(1, 0.5)
		actionBtn.Position = UDim2.new(1, -12, 0.5, 0)
		actionBtn.Size = UDim2.new(0, 110, 0, 34)
		actionBtn.BorderSizePixel = 0
		actionBtn.Font = Enum.Font.GothamBold
		actionBtn.TextSize = 12
		actionBtn.Parent = item

		local aCorner = Instance.new("UICorner")
		aCorner.CornerRadius = UDim.new(0, 6)
		aCorner.Parent = actionBtn

		if equippedInSlot then
			actionBtn.BackgroundColor3 = Color3.fromRGB(35, 60, 45)
			actionBtn.TextColor3 = Color3.fromRGB(140, 240, 160)
			actionBtn.Text = string.format("Slot %s [Assigned]", slotKeyNames[equippedInSlot])
			actionBtn.MouseButton1Click:Connect(function()
				-- Unequip from slot
				skillEquipRemote:FireServer("Unequip", equippedInSlot)
				equippedSlots[equippedInSlot] = ""
				refreshHotbarUI()
				renderModalSlotBar()
				renderSkillList()
			end)
		else
			actionBtn.BackgroundColor3 = Color3.fromRGB(190, 140, 30)
			actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			actionBtn.Text = string.format("Equip to [%s]", slotKeyNames[activeSelectSlot])
			actionBtn.MouseButton1Click:Connect(function()
				skillEquipRemote:FireServer("Equip", activeSelectSlot, skillName)
				equippedSlots[activeSelectSlot] = skillName
				refreshHotbarUI()
				renderModalSlotBar()
				renderSkillList()
			end)
		end
	end
end

local function toggleSkillBook()
	bookModal.Visible = not bookModal.Visible
	if bookModal.Visible then
		renderModalSlotBar()
		renderSkillList()
	end
end

bookToggleBtn.MouseButton1Click:Connect(toggleSkillBook)
bmCloseBtn.MouseButton1Click:Connect(function()
	bookModal.Visible = false
end)

--------------------------------------------------------------------------------
-- Skill Activation Execution Logic
--------------------------------------------------------------------------------
function activateSlot(slotIdx: number)
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	if player:GetAttribute("Cultivating") == true or player:GetAttribute("BreakingThrough") == true then
		return
	end

	local skillName = equippedSlots[slotIdx]
	if not skillName or skillName == "" then return end

	local skillDef = SkillConfig.Skills[skillName]
	if not skillDef then return end

	-- Check client cooldown
	local now = tick()
	local cdExpiry = clientCooldowns[skillName] or 0
	if now < cdExpiry then
		-- Flash red on hotbar
		local stroke = slotUIButtons[slotIdx]:FindFirstChild("SlotStroke") :: UIStroke?
		if stroke then
			local origColor = stroke.Color
			stroke.Color = Color3.fromRGB(255, 60, 60)
			task.delay(0.2, function()
				if stroke.Parent then stroke.Color = origColor end
			end)
		end
		return
	end

	-- Trigger Cooldown on Client
	clientCooldowns[skillName] = now + skillDef.Cooldown

	-- Visual Click Bounce
	local slotFrame = slotUIButtons[slotIdx]
	local bounceTween = TweenService:Create(slotFrame, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 82, 0, 82),
	})
	bounceTween:Play()
	task.delay(0.08, function()
		TweenService:Create(slotFrame, TweenInfo.new(0.12), { Size = UDim2.new(0, 76, 0, 76) }):Play()
	end)

	-- Procedural Animation
	playProceduralCastAnim(skillName)

	-- Gather Aim / Target Data
	local targetPos, aimDir = getAimTarget(skillDef.Range or 60)

	local targetData = {
		AimDirection = aimDir,
		TargetPosition = targetPos,
		TargetModel = (skillName == "Flame Spear") and lockedTargetModel or nil,
	}

	-- Send Authoritative Request to Server
	skillRequestRemote:FireServer(skillName, targetData)
end

--------------------------------------------------------------------------------
-- Keybind Input Listener (Z, X, C, V + K for Book)
--------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Prevent accidental activation while typing in chat or text boxes
	if gameProcessed or UserInputService:GetFocusedTextBox() ~= nil then
		return
	end

	if input.KeyCode == Enum.KeyCode.K then
		toggleSkillBook()
		return
	end

	for slotIdx = 1, 4 do
		if input.KeyCode == slotKeyCodes[slotIdx] then
			activateSlot(slotIdx)
			break
		end
	end
end)

--------------------------------------------------------------------------------
-- Cooldown & Lock-On Render Loop
--------------------------------------------------------------------------------
local reticle = ensureLockOnReticle()

RunService.RenderStepped:Connect(function()
	local now = tick()

	-- 1. Update Hotbar Cooldown Sweeps & Numbers
	for slotIdx = 1, 4 do
		local skillName = equippedSlots[slotIdx]
		local skillDef = SkillConfig.Skills[skillName]
		local cdOverlay = slotCooldownFrames[slotIdx]
		local cdText = slotCooldownTexts[slotIdx]

		if skillDef and clientCooldowns[skillName] then
			local remaining = clientCooldowns[skillName] - now
			if remaining > 0 then
				cdOverlay.Visible = true
				cdText.Visible = true

				local frac = math.clamp(remaining / skillDef.Cooldown, 0, 1)
				cdOverlay.Size = UDim2.new(1, 0, frac, 0)
				cdText.Text = string.format("%.1f", remaining)
			else
				cdOverlay.Visible = false
				cdText.Visible = false
			end
		else
			cdOverlay.Visible = false
			cdText.Visible = false
		end
	end

	-- 2. Update Lock-on Target for Flame Spear
	local hasFlameSpearEquipped = false
	for slot = 1, 4 do
		if equippedSlots[slot] == "Flame Spear" then
			hasFlameSpearEquipped = true
			break
		end
	end

	if hasFlameSpearEquipped then
		lockedTargetModel = updateLockOnTarget()
		if lockedTargetModel and lockedTargetModel.Parent then
			local tRoot = lockedTargetModel:FindFirstChild("HumanoidRootPart") or lockedTargetModel:FindFirstChild("Torso")
			if tRoot then
				reticle.Adornee = tRoot
				reticle.Enabled = true
			else
				reticle.Enabled = false
			end
		else
			reticle.Enabled = false
		end
	else
		reticle.Enabled = false
	end
end)

--------------------------------------------------------------------------------
-- Server Replication Listener (Plays anime VFX for all players)
--------------------------------------------------------------------------------
skillReplicateRemote.OnClientEvent:Connect(function(action: string, ...)
	local args = { ... }

	if action == "SwordSlash" then
		local casterChar, origin, dir, range, speed = args[1], args[2], args[3], args[4], args[5]
		if casterChar then
			SkillFXHelper.playSwordSlash(casterChar, origin, dir, range, speed)
		end
	elseif action == "PalmArt" then
		local casterChar, origin, lookDir, radius = args[1], args[2], args[3], args[4]
		if casterChar then
			SkillFXHelper.playPalmArt(casterChar, origin, lookDir, radius)
		end
	elseif action == "FlameBall" then
		local casterChar, origin, targetPos, speed, radius = args[1], args[2], args[3], args[4], args[5]
		if casterChar then
			SkillFXHelper.playFlameBall(casterChar, origin, targetPos, speed, radius)
		end
	elseif action == "ThunderStrike" then
		local targetPos, radius, warningDuration = args[1], args[2], args[3]
		SkillFXHelper.playThunderStrike(targetPos, radius, warningDuration)
	elseif action == "MultipleSwords" then
		local casterChar, origin, targetPos, count, speed = args[1], args[2], args[3], args[4], args[5]
		if casterChar then
			SkillFXHelper.playMultipleSwords(casterChar, origin, targetPos, count, speed)
		end
	elseif action == "FlameSpear" then
		local casterChar, origin, targetModel, targetPos, speed = args[1], args[2], args[3], args[4], args[5]
		if casterChar then
			SkillFXHelper.playFlameSpear(casterChar, origin, targetModel, targetPos, speed)
		end
	end
end)

-- Sync equipped slots from server
skillDataUpdateRemote.OnClientEvent:Connect(function(action: string, data: any)
	if action == "SyncEquipped" and type(data) == "table" then
		for slot = 1, 4 do
			equippedSlots[slot] = data[slot] or ""
		end
		refreshHotbarUI()
		if bookModal.Visible then
			renderModalSlotBar()
			renderSkillList()
		end
	end
end)

-- Initial UI build
buildHotbar()
refreshHotbarUI()

print("⚡ [SkillClient] Anime Combat Skill System HUD & Keybinds initialized.")
]]></string>
