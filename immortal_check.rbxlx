        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">SkillClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
    SkillClient.client.luau
    Client controller for the anime combat skill system:
    - Renders the 4-slot skill hotbar HUD with anime aesthetic (Z, X, C, V)
    - Manages cooldown overlays, countdown sweeps, and visual activation feedback
    - Listens for KeyCode.Z, KeyCode.X, KeyCode.C, KeyCode.V using UserInputService
    - Handles target aiming (mouse position, ground raycasting)
    - Dynamic Lock-On targeting system for Flame Spear with visible HUD reticle
    - Procedural procedural character casting animations (sword swings, palm thrusts, invocation postures)
    - Listens for server SkillReplicate to invoke SkillFXHelper
    - Interactive Skill Book Equip UI (opened via 'K' or '⚡ Skills' button):
      * View all 6 skills with descriptions, stats, icons, and cooldowns
      * Equip into any of the 4 slots, swap skills, or unequip
      * Live sync with server
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local camera = Workspace.CurrentCamera

local SkillConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SkillConfig"))
local SkillFXHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SkillFXHelper"))

local remotesFolder = ReplicatedStorage:WaitForChild("SkillRemotes")
local skillRequestRemote = remotesFolder:WaitForChild("SkillRequest") :: RemoteEvent
local skillReplicateRemote = remotesFolder:WaitForChild("SkillReplicate") :: RemoteEvent
local skillEquipRemote = remotesFolder:WaitForChild("SkillEquipRequest") :: RemoteEvent
local skillDataUpdateRemote = remotesFolder:WaitForChild("SkillDataUpdate") :: RemoteEvent

local screenGui = script.Parent :: ScreenGui

-- Client State
local equippedSlots: { [number]: string } = {
	[1] = "Sword Slash",
	[2] = "Palm Art",
	[3] = "Flame Ball",
	[4] = "Thunder Strike",
}

local clientCooldowns: { [string]: number } = {} -- [skillName] = expiryTick
local slotKeyCodes = {
	[1] = Enum.KeyCode.Z,
	[2] = Enum.KeyCode.X,
	[3] = Enum.KeyCode.C,
	[4] = Enum.KeyCode.V,
}
local slotKeyNames = {
	[1] = "Z",
	[2] = "X",
	[3] = "C",
	[4] = "V",
}

-- Lock-on state for Flame Spear
local lockedTargetModel: Model? = nil
local lockOnReticle: BillboardGui? = nil

--------------------------------------------------------------------------------
-- Procedural Character Animation Helpers
--------------------------------------------------------------------------------
local function playProceduralCastAnim(skillName: string)
	local char = player.Character
	if not char then return end

	local torso = char:FindFirstChild("Torso")
	if not torso then return end

	local rShoulder = torso:FindFirstChild("Right Shoulder") :: Motor6D?
	local lShoulder = torso:FindFirstChild("Left Shoulder") :: Motor6D?
	if not rShoulder or not rShoulder:IsA("Motor6D") then return end

	local origR = rShoulder.C0
	local origL = lShoulder and lShoulder.C0

	if skillName == "Sword Slash" then
		-- Windup: raise arm back
		rShoulder.C0 = origR * CFrame.Angles(math.rad(60), math.rad(-30), math.rad(45))
		task.delay(0.1, function()
			if rShoulder.Parent then
				-- Slash down across torso
				rShoulder.C0 = origR * CFrame.Angles(math.rad(-85), math.rad(50), math.rad(-30))
			end
		end)
		task.delay(0.35, function()
			if rShoulder.Parent then
				rShoulder.C0 = origR
			end
		end)
	elseif skillName == "Palm Art" then
		-- Thrust both palms forward
		rShoulder.C0 = origR * CFrame.Angles(math.rad(-90), 0, math.rad(15))
		if lShoulder and origL then
			lShoulder.C0 = origL * CFrame.Angles(math.rad(-90), 0, math.rad(-15))
		end
		task.delay(0.35, function()
			if rShoulder.Parent then rShoulder.C0 = origR end
			if lShoulder and lShoulder.Parent and origL then lShoulder.C0 = origL end
		end)
	elseif skillName == "Flame Ball" or skillName == "Multiple Swords" then
		-- Raise right hand aloft
		rShoulder.C0 = origR * CFrame.Angles(math.rad(-120), math.rad(-20), math.rad(10))
		task.delay(0.25, function()
			if rShoulder.Parent then
				-- Thrust arm toward aim
				rShoulder.C0 = origR * CFrame.Angles(math.rad(-80), 0, 0)
			end
		end)
		task.delay(0.45, function()
			if rShoulder.Parent then rShoulder.C0 = origR end
		end)
	elseif skillName == "Thunder Strike" then
		-- Sky invocation with both arms
		rShoulder.C0 = origR * CFrame.Angles(math.rad(-135), 0, math.rad(25))
		if lShoulder and origL then
			lShoulder.C0 = origL * CFrame.Angles(math.rad(-135), 0, math.rad(-25))
		end
		task.delay(0.4, function()
			if rShoulder.Parent then rShoulder.C0 = origR end
			if lShoulder and lShoulder.Parent and origL then lShoulder.C0 = origL end
		end)
	elseif skillName == "Flame Spear" then
		-- Spear throw stance: pull arm back then launch
		rShoulder.C0 = origR * CFrame.Angles(math.rad(45), math.rad(-45), math.rad(60))
		task.delay(0.12, function()
			if rShoulder.Parent then
				rShoulder.C0 = origR * CFrame.Angles(math.rad(-95), math.rad(10), 0)
			end
		end)
		task.delay(0.4, function()
			if rShoulder.Parent then rShoulder.C0 = origR end
		end)
	end
end

--------------------------------------------------------------------------------
-- Targeting & Mouse Raycast Helpers
--------------------------------------------------------------------------------
local function getAimTarget(maxRange: number): (Vector3, Vector3)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local origin = root and root.Position or Vector3.new()

	local ray = mouse.UnitRay
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = char and { char } or {}

	local result = Workspace:Raycast(ray.Origin, ray.Direction * (maxRange or 100), rayParams)
	local targetPos = result and result.Position or (ray.Origin + ray.Direction * (maxRange or 60))
	local direction = (targetPos - origin).Unit

	return targetPos, direction
end

-- Lock-On Detection for Flame Spear
local function updateLockOnTarget(): Model?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local bestTarget: Model? = nil
	local bestDist = 55
	local mouseRay = mouse.UnitRay

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") and descendant.Health > 0 then
			local model = descendant.Parent
			if model and model:IsA("Model") and model ~= char then
				local tRoot = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
				if tRoot and tRoot:IsA("BasePart") then
					local distToPlayer = (tRoot.Position - root.Position).Magnitude
					if distToPlayer <= 55 then
						-- Check proximity to mouse ray
						local toTarget = tRoot.Position - mouseRay.Origin
						local proj = toTarget:Dot(mouseRay.Direction)
						if proj > 0 then
							local closestPoint = mouseRay.Origin + mouseRay.Direction * proj
							local rayDist = (closestPoint - tRoot.Position).Magnitude
							if rayDist < 12 and distToPlayer < bestDist then
								bestTarget = model
								bestDist = distToPlayer
							end
						end
					end
				end
			end
		end
	end

	return bestTarget
end

-- Reticle Visual Billboard
local function ensureLockOnReticle()
	if not lockOnReticle then
		lockOnReticle = Instance.new("BillboardGui")
		lockOnReticle.Name = "LockOnReticle"
		lockOnReticle.Size = UDim2.new(0, 48, 0, 48)
		lockOnReticle.AlwaysOnTop = true
		lockOnReticle.Enabled = false

		local ring = Instance.new("ImageLabel")
		ring.Name = "ReticleRing"
		ring.BackgroundTransparency = 1
		ring.Size = UDim2.new(1, 0, 1, 0)
		ring.Image = "rbxassetid://6031075931" -- Crosshair circle
		ring.ImageColor3 = Color3.fromRGB(255, 70, 30)
		ring.Parent = lockOnReticle

		lockOnReticle.Parent = screenGui
	end
	return lockOnReticle
end

--------------------------------------------------------------------------------
-- HUD: 4-Slot Skill Hotbar (Z, X, C, V)
--------------------------------------------------------------------------------
local hotbarContainer = Instance.new("Frame")
hotbarContainer.Name = "SkillHotbar"
hotbarContainer.AnchorPoint = Vector2.new(0.5, 1)
hotbarContainer.Position = UDim2.new(0.5, 0, 1, -22)
hotbarContainer.Size = UDim2.new(0, 360, 0, 80)
hotbarContainer.BackgroundTransparency = 1
hotbarContainer.Parent = screenGui

local slotUIButtons: { [number]: Frame } = {}
local slotCooldownFrames: { [number]: Frame } = {}
local slotCooldownTexts: { [number]: TextLabel } = {}
local slotSkillNameTexts: { [number]: TextLabel } = {}
local slotKeyBadges: { [number]: TextLabel } = {}
local slotIconLabels: { [number]: TextLabel } = {}

local function buildHotbar()
	for slotIdx = 1, 4 do
		local slotFrame = Instance.new("Frame")
		slotFrame.Name = "Slot_" .. slotIdx
		slotFrame.Size = UDim2.new(0, 76, 0, 76)
		slotFrame.Position = UDim2.new(0, (slotIdx - 1) * 92, 0, 2)
		slotFrame.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
		slotFrame.BorderSizePixel = 0
		slotFrame.Parent = hotbarContainer

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = slotFrame

		local stroke = Instance.new("UIStroke")
		stroke.Name = "SlotStroke"
		stroke.Color = Color3.fromRGB(55, 60, 80)
		stroke.Thickness = 1.5
		stroke.Parent = slotFrame

		-- Skill Icon (Emoji / Symbol)
		local iconLbl = Instance.new("TextLabel")
		iconLbl.Name = "Icon"
		iconLbl.BackgroundTransparency = 1
		iconLbl.Position = UDim2.new(0, 0, 0, 6)
		iconLbl.Size = UDim2.new(1, 0, 0, 34)
		iconLbl.Text = "🗡️"
		iconLbl.TextSize = 28
		iconLbl.Parent = slotFrame
		slotIconLabels[slotIdx] = iconLbl

		-- Skill Name Label
		local nameLbl = Instance.new("TextLabel")
		nameLbl.Name = "SkillName"
		nameLbl.BackgroundTransparency = 1
		nameLbl.Position = UDim2.new(0, 2, 0, 42)
		nameLbl.Size = UDim2.new(1, -4, 0, 16)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.Text = "Sword Slash"
		nameLbl.TextColor3 = Color3.fromRGB(220, 225, 235)
		nameLbl.TextScaled = true
		nameLbl.Parent = slotFrame
		slotSkillNameTexts[slotIdx] = nameLbl

		-- Keybind Badge (Top-Left)
		local keyBadge = Instance.new("TextLabel")
		keyBadge.Name = "KeyBadge"
		keyBadge.Size = UDim2.new(0, 20, 0, 20)
		keyBadge.Position = UDim2.new(0, 4, 0, 4)
		keyBadge.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
		keyBadge.Font = Enum.Font.GothamBlack
		keyBadge.Text = slotKeyNames[slotIdx]
		keyBadge.TextColor3 = Color3.fromRGB(255, 215, 80)
		keyBadge.TextSize = 12
		keyBadge.Parent = slotFrame

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 4)
		bCorner.Parent = keyBadge

		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(90, 80, 50)
		bStroke.Thickness = 1
		bStroke.Parent = keyBadge
		slotKeyBadges[slotIdx] = keyBadge

		-- Cooldown Dark Overlay
		local cdOverlay = Instance.new("Frame")
		cdOverlay.Name = "CooldownOverlay"
		cdOverlay.BackgroundColor3 = Color3.fromRGB(5, 5, 8)
		cdOverlay.BackgroundTransparency = 0.4
		cdOverlay.BorderSizePixel = 0
		cdOverlay.Size = UDim2.new(1, 0, 0, 0)
		cdOverlay.Position = UDim2.new(0, 0, 1, 0)
		cdOverlay.AnchorPoint = Vector2.new(0, 1)
		cdOverlay.Visible = false
		cdOverlay.Parent = slotFrame

		local cdCorner = Instance.new("UICorner")
		cdCorner.CornerRadius = UDim.new(0, 10)
		cdCorner.Parent = cdOverlay
		slotCooldownFrames[slotIdx] = cdOverlay

		-- Cooldown Timer Number
		local cdText = Instance.new("TextLabel")
		cdText.Name = "CooldownText"
		cdText.BackgroundTransparency = 1
		cdText.Size = UDim2.new(1, 0, 1, 0)
		cdText.Font = Enum.Font.GothamBlack
		cdText.Text = ""
		cdText.TextColor3 = Color3.fromRGB(255, 255, 255)
		cdText.TextSize = 22
		cdText.Visible = false
		cdText.Parent = slotFrame
		slotCooldownTexts[slotIdx] = cdText

		-- Click slot to trigger skill as alternative to keybind
		local clickBtn = Instance.new("TextButton")
		clickBtn.Name = "ClickHitbox"
		clickBtn.BackgroundTransparency = 1
		clickBtn.Size = UDim2.new(1, 0, 1, 0)
		clickBtn.Text = ""
		clickBtn.Parent = slotFrame

		clickBtn.MouseButton1Click:Connect(function()
			activateSlot(slotIdx)
		end)

		slotUIButtons[slotIdx] = slotFrame
	end
end

local function refreshHotbarUI()
	for slotIdx = 1, 4 do
		local skillName = equippedSlots[slotIdx]
		local skillDef = SkillConfig.Skills[skillName]

		if skillDef then
			slotSkillNameTexts[slotIdx].Text = skillDef.Name
			slotIconLabels[slotIdx].Text = skillDef.IconSymbol
			local stroke = slotUIButtons[slotIdx]:FindFirstChild("SlotStroke") :: UIStroke?
			if stroke then
				stroke.Color = skillDef.Color
			end
		else
			slotSkillNameTexts[slotIdx].Text = "[Empty]"
			slotIconLabels[slotIdx].Text = "➕"
			local stroke = slotUIButtons[slotIdx]:FindFirstChild("SlotStroke") :: UIStroke?
			if stroke then
				stroke.Color = Color3.fromRGB(55, 60, 80)
			end
		end
	end
end

