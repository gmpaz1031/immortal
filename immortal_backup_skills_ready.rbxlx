      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local DataStoreService = game:GetService("DataStoreService")

local cultivationRemote = ReplicatedStorage:WaitForChild("CultivationRemote")
local punchCooldowns = {}

-- Safe DataStore setup (falls back gracefully if API access is disabled in Studio)
local playerDataStore = nil
pcall(function()
	playerDataStore = DataStoreService:GetDataStore("CultivationData_v1")
end)

--------------------------------------------------------------------------------
-- Item Catalog Definitions
--------------------------------------------------------------------------------
local SHOP_ITEMS = {
	["Qi Condensation Pill"] = {
		Price = 30,
		Rarity = "Rare",
		Description = "Concentrated spiritual essence pill. Amplifies Qi gathering speed by 2x for 5 minutes."
	},
	["Lesser Qi Pill"] = {
		Price = 15,
		Rarity = "Common",
		Description = "Spiritual nourishment. Instantly restores +50 Qi."
	},
	["Spirit Spring Elixir"] = {
		Price = 20,
		Rarity = "Uncommon",
		Description = "Sacred mountain dew. Instantly restores 100% of your Total Health."
	},
	["Helmet"] = {
		Price = 80,
		Rarity = "Uncommon",
		Description = "Sturdy martial helmet. Adds +10 Total Health and +10 Defense."
	},
	["Armor"] = {
		Price = 100,
		Rarity = "Rare",
		Description = "Forged warrior armor. Adds +10 Total Health and +10 Defense."
	}
}

--------------------------------------------------------------------------------
-- Realm Requirements & Calculations
--------------------------------------------------------------------------------
local function requirementFor(player)
	if player:GetAttribute("Realm") ~= "Qi Condensation" then
		return nil
	end

	local level = player:GetAttribute("RealmLevel") or 0
	return math.floor(100 * (2.5 ^ level) + 0.5)
end

local function updatePlayerStats(player)
	local level = player:GetAttribute("RealmLevel") or 0
	local baseDmg = 10 + (level * 5)
	local baseQiMult = 1.0 + (level * 0.25)
	local luckVal = 10 + (level * 2)

	local expiry = player:GetAttribute("PillBuffExpiry") or 0
	local isPillActive = expiry > os.time()
	local pillMult = isPillActive and (player:GetAttribute("PillMultiplier") or 2) or 1
	local effectiveQiMult = baseQiMult * pillMult

	-- Calculate Equipment Bonuses (+10 Health & +10 Defense per equipped piece)
	local hasHelmet = player:GetAttribute("EquippedHelmet") == true
	local hasArmor = player:GetAttribute("EquippedArmor") == true
	local defenseVal = 0
	local bonusMaxHp = 0

	if hasHelmet then
		defenseVal = defenseVal + 10
		bonusMaxHp = bonusMaxHp + 10
	end
	if hasArmor then
		defenseVal = defenseVal + 10
		bonusMaxHp = bonusMaxHp + 10
	end

	player:SetAttribute("Damage", baseDmg)
	player:SetAttribute("BaseQiMultiplier", baseQiMult)
	player:SetAttribute("QiMultiplier", effectiveQiMult)
	player:SetAttribute("Luck", luckVal)
	player:SetAttribute("Defense", defenseVal)

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		local newMaxHp = 100 + bonusMaxHp
		if hum.MaxHealth ~= newMaxHp then
			local diff = newMaxHp - hum.MaxHealth
			hum.MaxHealth = newMaxHp
			hum.Health = math.clamp(hum.Health + diff, 1, newMaxHp)
		end
	end
end

--------------------------------------------------------------------------------
-- Cosmetic Equipment Attachment (Helmet & Armor 3D Visual Models)
--------------------------------------------------------------------------------
local function updateEquippedCosmetics(player)
	local character = player.Character
	if not character then return end
	local head = character:FindFirstChild("Head")
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	if not head or not torso then return end

	-- 1. Helmet Cosmetic
	local existingHelm = character:FindFirstChild("EquippedHelmetModel")
	if player:GetAttribute("EquippedHelmet") then
		if not existingHelm then
			local helmModel = Instance.new("Model")
			helmModel.Name = "EquippedHelmetModel"

			local helmPart = Instance.new("Part")
			helmPart.Name = "HelmetPart"
			helmPart.Size = Vector3.new(1.35, 0.6, 1.35)
			helmPart.Color = Color3.fromRGB(65, 70, 80)
			helmPart.Material = Enum.Material.Metal
			helmPart.CanCollide = false
			helmPart.Anchored = false
			helmPart.CFrame = head.CFrame * CFrame.new(0, 0.45, 0)
			helmPart.Parent = helmModel

			-- Golden Forehead Crest
			local crest = Instance.new("Part")
			crest.Name = "HelmetCrest"
			crest.Size = Vector3.new(0.5, 0.4, 0.2)
			crest.Color = Color3.fromRGB(230, 185, 45)
			crest.Material = Enum.Material.Neon
			crest.CanCollide = false
			crest.Anchored = false
			crest.CFrame = head.CFrame * CFrame.new(0, 0.5, -0.68)
			crest.Parent = helmModel

			local weld1 = Instance.new("WeldConstraint")
			weld1.Part0 = head
			weld1.Part1 = helmPart
			weld1.Parent = helmPart

			local weld2 = Instance.new("WeldConstraint")
			weld2.Part0 = head
			weld2.Part1 = crest
			weld2.Parent = crest

			helmModel.Parent = character
		end
	else
		if existingHelm then
			existingHelm:Destroy()
		end
	end

	-- 2. Armor Cosmetic (Chestplate + Pauldrons)
	local existingArmor = character:FindFirstChild("EquippedArmorModel")
	if player:GetAttribute("EquippedArmor") then
		if not existingArmor then
			local armorModel = Instance.new("Model")
			armorModel.Name = "EquippedArmorModel"

			-- Chestplate
			local chest = Instance.new("Part")
			chest.Name = "Chestplate"
			chest.Size = Vector3.new(2.1, 1.8, 1.15)
			chest.Color = Color3.fromRGB(50, 55, 65)
			chest.Material = Enum.Material.Metal
			chest.CanCollide = false
			chest.Anchored = false
			chest.CFrame = torso.CFrame
			chest.Parent = armorModel

			local chestWeld = Instance.new("WeldConstraint")
			chestWeld.Part0 = torso
			chestWeld.Part1 = chest
			chestWeld.Parent = chest

			-- Pauldrons (Left & Right Shoulders)
			for _, xOff in ipairs({ -1.3, 1.3 }) do
				local pauldron = Instance.new("Part")
				pauldron.Name = "Pauldron"
				pauldron.Size = Vector3.new(0.9, 0.5, 1.2)
				pauldron.Color = Color3.fromRGB(210, 160, 40)
				pauldron.Material = Enum.Material.Metal
				pauldron.CanCollide = false
				pauldron.Anchored = false
				pauldron.CFrame = torso.CFrame * CFrame.new(xOff, 0.8, 0)
				pauldron.Parent = armorModel

				local pWeld = Instance.new("WeldConstraint")
				pWeld.Part0 = torso
				pWeld.Part1 = pauldron
				pWeld.Parent = pauldron
			end

			armorModel.Parent = character
		end
	else
		if existingArmor then
			existingArmor:Destroy()
		end
	end
end

--------------------------------------------------------------------------------
-- Dynamic Combat Tool Creation
--------------------------------------------------------------------------------
local function createCombatTool()
	local tool = Instance.new("Tool")
	tool.Name = "Combat"
	tool.CanBeDropped = false
	tool.RequiresHandle = false
	tool.ToolTip = "Click to punch enemies · 10 damage"

	local clientScript = Instance.new("LocalScript")
	clientScript.Name = "CombatClient"
	clientScript.Source = [[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local tool = script.Parent
local remote = ReplicatedStorage:WaitForChild("CultivationRemote")
local cooldown = false

local function playPunchAnimation()
	local character = player.Character
	local shoulder = character and character:FindFirstChild("RightShoulder", true)
	if not shoulder or not shoulder:IsA("Motor6D") then
		return
	end

	local original = shoulder.Transform
	shoulder.Transform = CFrame.Angles(math.rad(-75), 0, math.rad(20))
	task.delay(0.1, function()
		if shoulder.Parent then
			shoulder.Transform = CFrame.Angles(math.rad(20), 0, math.rad(-8))
		end
	end)
	task.delay(0.2, function()
		if shoulder.Parent then
			shoulder.Transform = original
		end
	end)
end

tool.Activated:Connect(function()
	if cooldown or tool.Parent ~= player.Character or player:GetAttribute("Cultivating") then
		return
	end

	cooldown = true
	playPunchAnimation()
	remote:FireServer("Punch")
	task.delay(0.45, function()
		cooldown = false
	end)
end)
]]
	clientScript.Parent = tool
	return tool
end

local function ensureCombatTool(player)
	local backpack = player:WaitForChild("Backpack", 5)
	if not backpack then return end
	local character = player.Character

	local hasInBackpack = backpack:FindFirstChild("Combat")
	local hasInChar = character and character:FindFirstChild("Combat")

	if not hasInBackpack and not hasInChar then
		local newTool = createCombatTool()
		newTool.Parent = backpack
	end

	local starterPack = game:GetService("StarterPack")
	if not starterPack:FindFirstChild("Combat") then
		local spTool = createCombatTool()
		spTool.Parent = starterPack
	end
end

--------------------------------------------------------------------------------
-- Character Status & Cultivation Anchoring
--------------------------------------------------------------------------------
local function updateCharacterStatus(player, isCultivating)
	local character = player.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	local status = character:FindFirstChild("CultivatingStatus")
	if status and head then
		status.Adornee = head
		status.Enabled = isCultivating
	end

	if root then
		root.Anchored = isCultivating
	end

	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not isCultivating)

		if isCultivating then
			if humanoid.WalkSpeed > 0 then
				player:SetAttribute("CultivationWalkSpeed", humanoid.WalkSpeed)
			end
			if humanoid.UseJumpPower then
				if humanoid.JumpPower > 0 then
					player:SetAttribute("CultivationJumpPower", humanoid.JumpPower)
				end
			else
				if humanoid.JumpHeight > 0 then
					player:SetAttribute("CultivationJumpHeight", humanoid.JumpHeight)
				end
			end

			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.JumpHeight = 0
		else
			local savedSpeed = player:GetAttribute("CultivationWalkSpeed")
			if not savedSpeed or savedSpeed <= 0 then
				savedSpeed = 16
			end
			humanoid.WalkSpeed = savedSpeed

			local savedJump = player:GetAttribute("CultivationJumpPower")
			if not savedJump or savedJump <= 0 then
				savedJump = 50
			end
			humanoid.JumpPower = savedJump

			local savedHeight = player:GetAttribute("CultivationJumpHeight")
			if not savedHeight or savedHeight <= 0 then
				savedHeight = 7.2
			end
			humanoid.JumpHeight = savedHeight

			humanoid.Sit = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function setCultivating(player, isCultivating)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if isCultivating then
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		if humanoid.FloorMaterial == Enum.Material.Air then
			return
		end
	end

	player:SetAttribute("Cultivating", isCultivating)
	updateCharacterStatus(player, isCultivating)
end

--------------------------------------------------------------------------------
-- Enemy Configuration & Combat
--------------------------------------------------------------------------------
local function isEnemyHumanoid(humanoid)
	local model = humanoid.Parent
	return model and model:IsA("Model") and not Players:GetPlayerFromCharacter(model)
end

local function configureEnemy(humanoid)
	if isEnemyHumanoid(humanoid) then
		humanoid.MaxHealth = 50
		humanoid.Health = 50
	end
end

for _, instance in Workspace:GetDescendants() do
	if instance:IsA("Humanoid") then
		configureEnemy(instance)
	end
end

Workspace.DescendantAdded:Connect(function(instance)
	if instance:IsA("Humanoid") then
		configureEnemy(instance)
	end
end)

local function punchNearbyEnemies(player)
	if player:GetAttribute("Cultivating") then
		return
	end

	local now = time()
	if punchCooldowns[player] and now - punchCooldowns[player] < 0.45 then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	punchCooldowns[player] = now
	local baseDamage = player:GetAttribute("Damage") or 10
	for _, instance in Workspace:GetDescendants() do
		if instance:IsA("Humanoid") and instance.Health > 0 and isEnemyHumanoid(instance) then
			local enemyRoot = instance.Parent:FindFirstChild("HumanoidRootPart")
			if enemyRoot and (enemyRoot.Position - root.Position).Magnitude <= 8 then
				instance:TakeDamage(baseDamage)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Inventory Helpers
--------------------------------------------------------------------------------
local function getInventoryFolder(player)
	local inv = player:FindFirstChild("Inventory")
	if not inv then
		inv = Instance.new("Folder")
		inv.Name = "Inventory"
		inv.Parent = player
	end
	return inv
end

local function addInventoryItem(player, itemName, count)
	local inv = getInventoryFolder(player)
	local itemVal = inv:FindFirstChild(itemName)
	if not itemVal then
		itemVal = Instance.new("IntValue")
		itemVal.Name = itemName
		itemVal.Value = 0
		itemVal.Parent = inv
	end
	itemVal.Value = itemVal.Value + (count or 1)
end

local function setInventoryItem(player, itemName, count)
	local inv = getInventoryFolder(player)
	local itemVal = inv:FindFirstChild(itemName)
	if not itemVal then
		itemVal = Instance.new("IntValue")
		itemVal.Name = itemName
		itemVal.Value = 0
		itemVal.Parent = inv
	end
	itemVal.Value = math.max(0, count or 0)
end

local function getInventoryItemCount(player, itemName)
	local inv = getInventoryFolder(player)
	local itemVal = inv:FindFirstChild(itemName)
	return itemVal and itemVal.Value or 0
end

local function consumeInventoryItem(player, itemName)
	local inv = getInventoryFolder(player)
	local itemVal = inv:FindFirstChild(itemName)
	if itemVal and itemVal.Value > 0 then
		itemVal.Value = itemVal.Value - 1
		return true
	end
	return false
end

--------------------------------------------------------------------------------
-- Auto-Save & Data Persistence System
--------------------------------------------------------------------------------
local function serializePlayerData(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	local goldVal = leaderstats and leaderstats:FindFirstChild("Gold") and leaderstats.Gold.Value or 0

	local invFolder = player:FindFirstChild("Inventory")
	local invTable = {}
	if invFolder then
		for _, child in ipairs(invFolder:GetChildren()) do
			if child:IsA("IntValue") and child.Value > 0 then
				invTable[child.Name] = child.Value
			end
		end
	end

	local data = {
		Gold = goldVal,
		Qi = player:GetAttribute("Qi") or 0,
		Realm = player:GetAttribute("Realm") or "Qi Condensation",
		RealmLevel = player:GetAttribute("RealmLevel") or 0,
		PillBuffExpiry = player:GetAttribute("PillBuffExpiry") or 0,
		EquippedHelmet = player:GetAttribute("EquippedHelmet") or false,
		EquippedArmor = player:GetAttribute("EquippedArmor") or false,
		Inventory = invTable,
		SavedAt = os.time()
	}
	return data
end

local function savePlayerData(player)
	if not playerDataStore then return end
	local key = "Player_" .. tostring(player.UserId)
	local data = serializePlayerData(player)
	local success, err = pcall(function()
		playerDataStore:SetAsync(key, data)
	end)
	if success then
		print(string.format("💾 [AutoSave] Successfully saved data for %s (Gold: %d, Qi: %d, Level: %d)", player.Name, data.Gold, data.Qi, data.RealmLevel))
	else
		warn(string.format("⚠️ [AutoSave] Failed to save data for %s: %s", player.Name, tostring(err)))
	end
end

local function loadPlayerData(player)
	if not playerDataStore then return false end
	local key = "Player_" .. tostring(player.UserId)
	local success, savedData = pcall(function()
		return playerDataStore:GetAsync(key)
	end)

	if success and savedData and type(savedData) == "table" then
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats and leaderstats:FindFirstChild("Gold") and savedData.Gold then
			leaderstats.Gold.Value = savedData.Gold
		end

		if savedData.Qi then player:SetAttribute("Qi", savedData.Qi) end
		if savedData.Realm then player:SetAttribute("Realm", savedData.Realm) end
		if savedData.RealmLevel then player:SetAttribute("RealmLevel", savedData.RealmLevel) end
		if savedData.PillBuffExpiry then player:SetAttribute("PillBuffExpiry", savedData.PillBuffExpiry) end
		if savedData.EquippedHelmet ~= nil then player:SetAttribute("EquippedHelmet", savedData.EquippedHelmet) end
		if savedData.EquippedArmor ~= nil then player:SetAttribute("EquippedArmor", savedData.EquippedArmor) end

		if savedData.Inventory and type(savedData.Inventory) == "table" then
			for itemName, count in pairs(savedData.Inventory) do
				setInventoryItem(player, itemName, count)
			end
		end

		print(string.format("📂 [AutoSave] Successfully loaded profile for %s (Gold: %d, Qi: %d, Level: %d)", player.Name, savedData.Gold or 0, savedData.Qi or 0, savedData.RealmLevel or 0))
		return true
	end
	return false
end

--------------------------------------------------------------------------------
-- Player Setup & Lifecycle
--------------------------------------------------------------------------------
local function setupPlayer(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local gold = Instance.new("IntValue")
	gold.Name = "Gold"
	gold.Value = 50 -- Starting gold for new players
	gold.Parent = leaderstats

	player:SetAttribute("Qi", 0)
	player:SetAttribute("Realm", "Qi Condensation")
	player:SetAttribute("RealmLevel", 0)
	player:SetAttribute("Cultivating", false)
	player:SetAttribute("CultivationWalkSpeed", 16)
	player:SetAttribute("CultivationJumpPower", 50)
	player:SetAttribute("CultivationJumpHeight", 7.2)
	player:SetAttribute("BreakingThrough", false)
	player:SetAttribute("PillBuffExpiry", 0)
	player:SetAttribute("PillMultiplier", 2)
	player:SetAttribute("Defense", 0)
	player:SetAttribute("EquippedHelmet", false)
	player:SetAttribute("EquippedArmor", false)

	-- Default starter inventory
	addInventoryItem(player, "Qi Condensation Pill", 1)

	-- Load saved data if available
	local loaded = loadPlayerData(player)
	if not loaded then
		print(string.format("✨ [AutoSave] Initialized new profile for %s", player.Name))
	end

	updatePlayerStats(player)

	local function onCharacter(character)
		player:SetAttribute("Cultivating", false)
		player:SetAttribute("BreakingThrough", false)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid then
			humanoid.Died:Connect(function()
				if player:GetAttribute("Cultivating") then
					setCultivating(player, false)
				end
			end)
		end
		updateCharacterStatus(player, false)
		ensureCombatTool(player)
		updatePlayerStats(player)
		updateEquippedCosmetics(player)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	ensureCombatTool(player)

	-- 1-second Qi gathering loop with active Pill Multiplier support
	task.spawn(function()
		while player.Parent do
			task.wait(1)
			updatePlayerStats(player)

			if player:GetAttribute("Cultivating") then
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local mult = player:GetAttribute("QiMultiplier") or 1
					local gained = math.floor(5 * mult + 0.5)
					player:SetAttribute("Qi", (player:GetAttribute("Qi") or 0) + gained)
				else
					setCultivating(player, false)
				end
			end
		end
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

-- Save on Player Leave
Players.PlayerRemoving:Connect(function(player)
	savePlayerData(player)
end)

-- Auto-Save Loop every 60 seconds
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerData(player)
		end
	end
end)

-- Save on Server Shutdown / BindToClose
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		savePlayerData(player)
	end
	task.wait(1.5)
end)

--------------------------------------------------------------------------------
-- In-World Shop Merchant NPC & Neon Circle
--------------------------------------------------------------------------------
local function spawnShopMerchant()
	local existing = Workspace:FindFirstChild("ShopMerchant")
	if existing then return existing end

	local merchantPos = Vector3.new(20, 0, -10)

	-- 1. Neon Circle on the ground
	local circle = Instance.new("Part")
	circle.Name = "ShopCircle"
	circle.Shape = Enum.PartType.Cylinder
	circle.Size = Vector3.new(0.3, 16, 16)
	circle.CFrame = CFrame.new(merchantPos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	circle.Material = Enum.Material.Neon
	circle.Color = Color3.fromRGB(0, 230, 255)
	circle.Anchored = true
	circle.CanCollide = false
	circle.CastShadow = false
	circle.Parent = Workspace

	-- 2. Merchant Model
	local model = Instance.new("Model")
	model.Name = "ShopMerchant"

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.CFrame = CFrame.new(merchantPos + Vector3.new(0, 3, 0))
	hrp.Transparency = 1
	hrp.Anchored = true
	hrp.CanCollide = false
	hrp.Parent = model
	model.PrimaryPart = hrp

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.CFrame = hrp.CFrame
	torso.Color = Color3.fromRGB(45, 25, 65)
	torso.Anchored = true
	torso.CanCollide = true
	torso.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.CFrame = hrp.CFrame + Vector3.new(0, 1.6, 0)
	head.Color = Color3.fromRGB(245, 215, 175)
	head.Anchored = true
	head.CanCollide = true
	head.Parent = model

	local leftArm = Instance.new("Part")
	leftArm.Name = "Left Arm"
	leftArm.Size = Vector3.new(1, 2, 1)
	leftArm.CFrame = hrp.CFrame + Vector3.new(-1.5, 0, 0)
	leftArm.Color = Color3.fromRGB(255, 215, 80)
	leftArm.Anchored = true
	leftArm.CanCollide = true
	leftArm.Parent = model

	local rightArm = Instance.new("Part")
	rightArm.Name = "Right Arm"
	rightArm.Size = Vector3.new(1, 2, 1)
	rightArm.CFrame = hrp.CFrame + Vector3.new(1.5, 0, 0)
	rightArm.Color = Color3.fromRGB(255, 215, 80)
	rightArm.Anchored = true
	rightArm.CanCollide = true
	rightArm.Parent = model

	local leftLeg = Instance.new("Part")
	leftLeg.Name = "Left Leg"
	leftLeg.Size = Vector3.new(1, 2, 1)
	leftLeg.CFrame = hrp.CFrame + Vector3.new(-0.5, -2, 0)
	leftLeg.Color = Color3.fromRGB(30, 18, 45)
	leftLeg.Anchored = true
	leftLeg.CanCollide = true
	leftLeg.Parent = model

	local rightLeg = Instance.new("Part")
	rightLeg.Name = "Right Leg"
	rightLeg.Size = Vector3.new(1, 2, 1)
	rightLeg.CFrame = hrp.CFrame + Vector3.new(0.5, -2, 0)
	rightLeg.Color = Color3.fromRGB(30, 18, 45)
	rightLeg.Anchored = true
	rightLeg.CanCollide = true
	rightLeg.Parent = model

	-- Floating BillboardGui
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "ShopLabel"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 240, 0, 60)
	bbg.StudsOffset = Vector3.new(0, 3.8, 0)
	bbg.Adornee = head
	bbg.Parent = model

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Size = UDim2.new(1, 0, 0.55, 0)
	titleLbl.Font = Enum.Font.GothamBlack
	titleLbl.Text = "🛒 PILL SHOP"
	titleLbl.TextColor3 = Color3.fromRGB(255, 215, 80)
	titleLbl.TextScaled = true
	titleLbl.Parent = bbg

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(40, 20, 10)
	titleStroke.Thickness = 1.8
	titleStroke.Parent = titleLbl

	local subLbl = Instance.new("TextLabel")
	subLbl.BackgroundTransparency = 1
	subLbl.Position = UDim2.new(0, 0, 0.55, 0)
	subLbl.Size = UDim2.new(1, 0, 0.45, 0)
	subLbl.Font = Enum.Font.GothamBold
	subLbl.Text = "[E] Click or Walk Close"
	subLbl.TextColor3 = Color3.fromRGB(0, 235, 255)
	subLbl.TextScaled = true
	subLbl.Parent = bbg

	-- ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = "Pill Pavilion"
	prompt.ActionText = "Browse Shop"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = hrp

	prompt.Triggered:Connect(function(player)
		cultivationRemote:FireClient(player, "OpenShop")
	end)

	local clickDetector = Instance.new("ClickDetector")
	clickDetector.MaxActivationDistance = 18
	clickDetector.Parent = model

	clickDetector.MouseClick:Connect(function(player)
		cultivationRemote:FireClient(player, "OpenShop")
	end)

	-- Stepping on circle opens shop
	local touchDebounce = {}
	circle.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = Players:GetPlayerFromCharacter(char)
		if player and (not touchDebounce[player] or tick() - touchDebounce[player] > 3) then
			touchDebounce[player] = tick()
			cultivationRemote:FireClient(player, "OpenShop")
		end
	end)

	model.Parent = Workspace
end

task.spawn(spawnShopMerchant)

task.spawn(function()
	task.wait(1)
	local vg = script:WaitForChild("VillageGenerator", 5)
	if vg then
		local ok, mod = pcall(require, vg)
		if ok and mod and mod.generate then
			mod.generate()
		end
	end

	-- Initialize Bandit Stronghold Village
	local bv = script:WaitForChild("BanditVillage", 5)
	if bv then
		local ok, mod = pcall(require, bv)
		if ok and mod and mod.generate then
			mod.generate()
		end
	end

	-- Initialize Bandit Enemies & Boss AI
	local bm = script:WaitForChild("BanditManager", 5)
	if bm then
		local ok, mod = pcall(require, bm)
		if ok and mod and mod.init then
			mod.init()
		end
	end

	-- Initialize Combat Skill System Service
	local ss = script:WaitForChild("SkillService", 5)
	if ss then
		local ok, err = pcall(function()
			local mod = require(ss)
			if mod and mod.init then
				mod.init()
			end
		end)
		if not ok then
			warn("❌ [SkillService] Failed to initialize:", err)
		end
	else
		warn("⚠️ [SkillService] SkillService ModuleScript not found in Server!")
	end
end)

--------------------------------------------------------------------------------
-- Remote Event Router & Admin Commands
--------------------------------------------------------------------------------
cultivationRemote.OnServerEvent:Connect(function(player, action, ...)
	local args = { ... }

	if action == "Cultivate" then
		setCultivating(player, not player:GetAttribute("Cultivating"))
		return
	end

	if action == "Punch" then
		punchNearbyEnemies(player)
		return
	end

	if action == "Breakthrough" then
		if player:GetAttribute("BreakingThrough") then
			return
		end

		local required = requirementFor(player)
		local qi = player:GetAttribute("Qi") or 0
		if not required or qi < required then
			return
		end

		if player:GetAttribute("Cultivating") then
			setCultivating(player, false)
		end

		player:SetAttribute("BreakingThrough", true)
		cultivationRemote:FireAllClients("BreakthroughStart", player)

		task.delay(2.6, function()
			if not player.Parent then return end

			local reqNow = requirementFor(player)
			local qiNow = player:GetAttribute("Qi") or 0
			if not reqNow or qiNow < reqNow then
				player:SetAttribute("BreakingThrough", false)
				return
			end

			player:SetAttribute("Qi", qiNow - reqNow)
			local level = player:GetAttribute("RealmLevel") or 0
			if level < 10 then
				player:SetAttribute("RealmLevel", level + 1)
			else
				player:SetAttribute("Realm", "Bone Forging Realm")
				player:SetAttribute("RealmLevel", 1)
			end
			updatePlayerStats(player)
			savePlayerData(player)

			cultivationRemote:FireAllClients("BreakthroughBurst", player)

			task.delay(1.2, function()
				if player.Parent then
					player:SetAttribute("BreakingThrough", false)
				end
			end)
		end)
		return
	end

	-- Shop Buy Action
	if action == "BuyItem" then
		local itemName = args[1]
		local itemData = SHOP_ITEMS[itemName]
		if not itemData then return end

		local leaderstats = player:FindFirstChild("leaderstats")
		local gold = leaderstats and leaderstats:FindFirstChild("Gold")
		if not gold or gold.Value < itemData.Price then
			cultivationRemote:FireClient(player, "Notification", "Not enough Gold!")
			return
		end

		gold.Value = gold.Value - itemData.Price
		addInventoryItem(player, itemName, 1)
		savePlayerData(player)
		cultivationRemote:FireClient(player, "Notification", "Purchased " .. itemName .. "!")
		return
	end

	-- Inventory Use Action
	if action == "UseItem" then
		local itemName = args[1]
		if not itemName then return end

		local count = getInventoryItemCount(player, itemName)
		if count <= 0 then
			cultivationRemote:FireClient(player, "Notification", "You do not have any " .. itemName .. "!")
			return
		end

		if itemName == "Qi Condensation Pill" then
			if consumeInventoryItem(player, itemName) then
				local currentExpiry = player:GetAttribute("PillBuffExpiry") or 0
				local now = os.time()
				local newExpiry = math.max(now, currentExpiry) + 300 -- 5 minutes (300s)
				player:SetAttribute("PillBuffExpiry", newExpiry)
				player:SetAttribute("PillMultiplier", 2)
				updatePlayerStats(player)
				savePlayerData(player)
				cultivationRemote:FireClient(player, "Notification", "Consumed Qi Condensation Pill! 2x Qi for 5 minutes!")
			end
		elseif itemName == "Lesser Qi Pill" then
			if consumeInventoryItem(player, itemName) then
				player:SetAttribute("Qi", (player:GetAttribute("Qi") or 0) + 50)
				savePlayerData(player)
				cultivationRemote:FireClient(player, "Notification", "Consumed Lesser Qi Pill! +50 Qi gained!")
			end
		elseif itemName == "Spirit Spring Elixir" then
			if consumeInventoryItem(player, itemName) then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.Health = hum.MaxHealth
				end
				savePlayerData(player)
				cultivationRemote:FireClient(player, "Notification", "Drank Spirit Spring Elixir! Health fully restored!")
			end
		end
		return
	end

	-- Equip Item Action
	if action == "EquipItem" then
		local itemName = args[1]
		local count = getInventoryItemCount(player, itemName)
		if count <= 0 then
			cultivationRemote:FireClient(player, "Notification", "You do not own a " .. tostring(itemName) .. "!")
			return
		end

		if itemName == "Helmet" then
			player:SetAttribute("EquippedHelmet", true)
			updatePlayerStats(player)
			updateEquippedCosmetics(player)
			savePlayerData(player)
			cultivationRemote:FireClient(player, "Notification", "🛡️ Equipped Helmet! (+10 Max Health, +10 Defense)")
		elseif itemName == "Armor" then
			player:SetAttribute("EquippedArmor", true)
			updatePlayerStats(player)
			updateEquippedCosmetics(player)
			savePlayerData(player)
			cultivationRemote:FireClient(player, "Notification", "🛡️ Equipped Armor! (+10 Max Health, +10 Defense)")
		end
		return
	end

	-- Unequip Item Action
	if action == "UnequipItem" then
		local itemName = args[1]
		if itemName == "Helmet" then
			player:SetAttribute("EquippedHelmet", false)
			updatePlayerStats(player)
			updateEquippedCosmetics(player)
			savePlayerData(player)
			cultivationRemote:FireClient(player, "Notification", "Unequipped Helmet.")
		elseif itemName == "Armor" then
			player:SetAttribute("EquippedArmor", false)
			updatePlayerStats(player)
			updateEquippedCosmetics(player)
			savePlayerData(player)
			cultivationRemote:FireClient(player, "Notification", "Unequipped Armor.")
		end
		return
	end

	----------------------------------------------------------------------------
	-- Admin Panel Server Actions (Adds currency, qi, items, levels, save, etc.)
	----------------------------------------------------------------------------
	if action == "AdminAction" then
		local subAction = args[1]
		local param = args[2]

		if subAction == "AddGold" then
			local amount = tonumber(param) or 1000
			local leaderstats = player:FindFirstChild("leaderstats")
			local gold = leaderstats and leaderstats:FindFirstChild("Gold")
			if gold then
				gold.Value = math.max(0, gold.Value + amount)
				cultivationRemote:FireClient(player, "Notification", string.format("⚡ Admin: Added %d Gold!", amount))
			end
		elseif subAction == "AddQi" then
			local amount = tonumber(param) or 500
			local currentQi = player:GetAttribute("Qi") or 0
			player:SetAttribute("Qi", math.max(0, currentQi + amount))
			cultivationRemote:FireClient(player, "Notification", string.format("⚡ Admin: Added %d Qi!", amount))
		elseif subAction == "SetRealmLevel" then
			local newLevel = math.clamp(tonumber(param) or 0, 10)
			player:SetAttribute("RealmLevel", newLevel)
			updatePlayerStats(player)
			cultivationRemote:FireClient(player, "Notification", string.format("⚡ Admin: Set Realm Level to %d!", newLevel))
		elseif subAction == "AddItem" then
			local itemName = tostring(param)
			if SHOP_ITEMS[itemName] or itemName == "Qi Condensation Pill" or itemName == "Lesser Qi Pill" or itemName == "Spirit Spring Elixir" or itemName == "Helmet" or itemName == "Armor" then
				local qty = tonumber(args[3]) or 5
				addInventoryItem(player, itemName, qty)
				cultivationRemote:FireClient(player, "Notification", string.format("⚡ Admin: Added %dx %s!", qty, itemName))
			end
		elseif subAction == "HealFull" then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = hum.MaxHealth
				cultivationRemote:FireClient(player, "Notification", "⚡ Admin: Fully Healed Character!")
			end
		elseif subAction == "MaxBuff" then
			local now = os.time()
			player:SetAttribute("PillBuffExpiry", now + 3600) -- 1 hour buff
			player:SetAttribute("PillMultiplier", 5) -- 5x multiplier!
			updatePlayerStats(player)
			cultivationRemote:FireClient(player, "Notification", "⚡ Admin: Applied 5x Qi Mega-Buff (1 hour)!")
		elseif subAction == "SaveNow" then
			savePlayerData(player)
			cultivationRemote:FireClient(player, "Notification", "⚡ Admin: Force Saved Data to DataStore!")
		end

		savePlayerData(player)
		return
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">BanditManager</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local BanditManager = {}

local cultivationRemote = ReplicatedStorage:WaitForChild("CultivationRemote")

--------------------------------------------------------------------------------
-- Color & Visual Constants
--------------------------------------------------------------------------------
local BANDIT_COLORS = {
	Skin = Color3.fromRGB(225, 185, 145),
	Torso = Color3.fromRGB(65, 42, 32), -- Dark leather vest
	Legs = Color3.fromRGB(38, 38, 42),  -- Charcoal pants
	Bandana = Color3.fromRGB(155, 30, 30), -- Crimson headband/mask
	BossSkin = Color3.fromRGB(210, 170, 135),
	BossTorso = Color3.fromRGB(90, 20, 20), -- Heavy spiked crimson breastplate
	BossArmorTrim = Color3.fromRGB(220, 170, 45), -- Gold trim
	BossLegs = Color3.fromRGB(25, 25, 30),
	BossHorns = Color3.fromRGB(40, 40, 45),
}

--------------------------------------------------------------------------------
-- Helper: Build a Standard R6 Humanoid Rig
--------------------------------------------------------------------------------
local function buildR6Rig(name, scale, isBoss)
	scale = scale or 1.0

	local model = Instance.new("Model")
	model.Name = name

	-- 1. HumanoidRootPart
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2 * scale, 2 * scale, 1 * scale)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.Anchored = false
	hrp.Parent = model
	model.PrimaryPart = hrp

	-- 2. Torso
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2 * scale, 2 * scale, 1 * scale)
	torso.Color = isBoss and BANDIT_COLORS.BossTorso or BANDIT_COLORS.Torso
	torso.Material = Enum.Material.Fabric
	torso.CanCollide = false
	torso.Anchored = false
	torso.Parent = model

	-- 3. Head
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.25 * scale, 1.25 * scale, 1.25 * scale)
	head.Color = isBoss and BANDIT_COLORS.BossSkin or BANDIT_COLORS.Skin
	head.CanCollide = false
	head.Anchored = false
	head.Parent = model

	-- 4. Left & Right Arms
	local leftArm = Instance.new("Part")
	leftArm.Name = "Left Arm"
	leftArm.Size = Vector3.new(1 * scale, 2 * scale, 1 * scale)
	leftArm.Color = isBoss and BANDIT_COLORS.BossTorso or BANDIT_COLORS.Skin
	leftArm.Material = Enum.Material.SmoothPlastic
	leftArm.CanCollide = false
	leftArm.Anchored = false
	leftArm.Parent = model

	local rightArm = Instance.new("Part")
	rightArm.Name = "Right Arm"
	rightArm.Size = Vector3.new(1 * scale, 2 * scale, 1 * scale)
	rightArm.Color = isBoss and BANDIT_COLORS.BossTorso or BANDIT_COLORS.Skin
	rightArm.Material = Enum.Material.SmoothPlastic
	rightArm.CanCollide = false
	rightArm.Anchored = false
	rightArm.Parent = model

	-- 5. Left & Right Legs
	local leftLeg = Instance.new("Part")
	leftLeg.Name = "Left Leg"
	leftLeg.Size = Vector3.new(1 * scale, 2 * scale, 1 * scale)
	leftLeg.Color = isBoss and BANDIT_COLORS.BossLegs or BANDIT_COLORS.Legs
	leftLeg.Material = Enum.Material.Fabric
	leftLeg.CanCollide = false
	leftLeg.Anchored = false
	leftLeg.Parent = model

	local rightLeg = Instance.new("Part")
	rightLeg.Name = "Right Leg"
	rightLeg.Size = Vector3.new(1 * scale, 2 * scale, 1 * scale)
	rightLeg.Color = isBoss and BANDIT_COLORS.BossLegs or BANDIT_COLORS.Legs
	rightLeg.Material = Enum.Material.Fabric
	rightLeg.CanCollide = false
	rightLeg.Anchored = false
	rightLeg.Parent = model

	-- 6. Motor6D Joints
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = torso
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = CFrame.new()
	rootJoint.Parent = hrp

	local neck = Instance.new("Motor6D")
	neck.Name = "Neck"
	neck.Part0 = torso
	neck.Part1 = head
	neck.C0 = CFrame.new(0, 1 * scale, 0)
	neck.C1 = CFrame.new(0, -0.5 * scale, 0)
	neck.Parent = torso

	local rightShoulder = Instance.new("Motor6D")
	rightShoulder.Name = "Right Shoulder"
	rightShoulder.Part0 = torso
	rightShoulder.Part1 = rightArm
	rightShoulder.C0 = CFrame.new(1 * scale + (0.5 * scale), 0.5 * scale, 0)
	rightShoulder.C1 = CFrame.new(0, 0.5 * scale, 0)
	rightShoulder.Parent = torso

	local leftShoulder = Instance.new("Motor6D")
	leftShoulder.Name = "Left Shoulder"
	leftShoulder.Part0 = torso
	leftShoulder.Part1 = leftArm
	leftShoulder.C0 = CFrame.new(-1 * scale - (0.5 * scale), 0.5 * scale, 0)
	leftShoulder.C1 = CFrame.new(0, 0.5 * scale, 0)
	leftShoulder.Parent = torso

	local rightHip = Instance.new("Motor6D")
	rightHip.Name = "Right Hip"
	rightHip.Part0 = torso
	rightHip.Part1 = rightLeg
	rightHip.C0 = CFrame.new(0.5 * scale, -1 * scale, 0)
	rightHip.C1 = CFrame.new(0, 1 * scale, 0)
	rightHip.Parent = torso

	local leftHip = Instance.new("Motor6D")
	leftHip.Name = "Left Hip"
	leftHip.Part0 = torso
	leftHip.Part1 = leftLeg
	leftHip.C0 = CFrame.new(-0.5 * scale, -1 * scale, 0)
	leftHip.C1 = CFrame.new(0, 1 * scale, 0)
	leftHip.Parent = torso

	-- 7. Humanoid
	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.DisplayName = name
	humanoid.MaxHealth = isBoss and 280 or 60
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = isBoss and 13 or 11
	humanoid.HipHeight = 2 * scale
	humanoid.Parent = model

	-- Visual accessories: Bandana / Pauldrons / Helm
	if isBoss then
		-- Spiked Pauldrons (Shoulder armor)
		for _, xOff in ipairs({ -1.5 * scale, 1.5 * scale }) do
			local pauldron = Instance.new("Part")
			pauldron.Name = "BossPauldron"
			pauldron.Size = Vector3.new(1.3 * scale, 0.7 * scale, 1.3 * scale)
			pauldron.Color = BANDIT_COLORS.BossArmorTrim
			pauldron.Material = Enum.Material.Metal
			pauldron.CanCollide = false
			pauldron.Anchored = false

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = torso
			weld.Part1 = pauldron
			weld.Parent = pauldron

			pauldron.CFrame = torso.CFrame * CFrame.new(xOff, 0.8 * scale, 0)
			pauldron.Parent = model
		end

		-- Horned Boss Crown on Head
		local crown = Instance.new("Part")
		crown.Name = "BossCrown"
		crown.Size = Vector3.new(1.3 * scale, 0.4 * scale, 1.3 * scale)
		crown.Color = BANDIT_COLORS.BossArmorTrim
		crown.Material = Enum.Material.Metal
		crown.CanCollide = false
		crown.Anchored = false

		local cWeld = Instance.new("WeldConstraint")
		cWeld.Part0 = head
		cWeld.Part1 = crown
		cWeld.Parent = crown

		crown.CFrame = head.CFrame * CFrame.new(0, 0.7 * scale, 0)
		crown.Parent = model
	else
		-- Crimson Bandit Headband
		local bandana = Instance.new("Part")
		bandana.Name = "Bandana"
		bandana.Size = Vector3.new(1.3 * scale, 0.35 * scale, 1.3 * scale)
		bandana.Color = BANDIT_COLORS.Bandana
		bandana.Material = Enum.Material.Fabric
		bandana.CanCollide = false
		bandana.Anchored = false

		local bWeld = Instance.new("WeldConstraint")
		bWeld.Part0 = head
		bWeld.Part1 = bandana
		bWeld.Parent = bandana

		bandana.CFrame = head.CFrame * CFrame.new(0, 0.3 * scale, 0)
		bandana.Parent = model
	end

	-- 8. Overhead Health Bar Billboard (compact: small name + health bar)
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "EnemyHealthGui"
	bbg.AlwaysOnTop = true
	bbg.Size = isBoss and UDim2.new(0, 120, 0, 28) or UDim2.new(0, 100, 0, 24)
	bbg.StudsOffset = Vector3.new(0, (2.6 + (isBoss and 1.0 or 0)) * scale, 0)
	bbg.Adornee = head
	bbg.Parent = model

	-- Small name label above the health bar
	local nameLbl = Instance.new("TextLabel")
	nameLbl.Name = "NameLabel"
	nameLbl.BackgroundTransparency = 1
	nameLbl.Size = UDim2.new(1, 0, 0, 12)
	nameLbl.Position = UDim2.new(0, 0, 0, 0)
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.Text = isBoss and "Bandit Boss" or "Bandit"
	nameLbl.TextColor3 = isBoss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 220, 100)
	nameLbl.TextSize = isBoss and 11 or 10
	nameLbl.Parent = bbg

	local nameStroke = Instance.new("UIStroke")
	nameStroke.Color = Color3.fromRGB(20, 10, 10)
	nameStroke.Thickness = 1
	nameStroke.Parent = nameLbl

	-- Health bar frame sits below the name
	local hpFrame = Instance.new("Frame")
	hpFrame.Name = "HpBar"
	hpFrame.BackgroundColor3 = Color3.fromRGB(35, 20, 20)
	hpFrame.BorderSizePixel = 0
	hpFrame.Position = UDim2.new(0, 0, 0, 14)
	hpFrame.Size = isBoss and UDim2.new(1, 0, 0, 12) or UDim2.new(1, 0, 0, 10)
	hpFrame.Parent = bbg

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 3)
	hpCorner.Parent = hpFrame

	local hpFill = Instance.new("Frame")
	hpFill.Name = "Fill"
	hpFill.BackgroundColor3 = isBoss and Color3.fromRGB(230, 35, 45) or Color3.fromRGB(210, 60, 40)
	hpFill.BorderSizePixel = 0
	hpFill.Size = UDim2.new(1, 0, 1, 0)
	hpFill.Parent = hpFrame

	local hpFillCorner = Instance.new("UICorner")
	hpFillCorner.CornerRadius = UDim.new(0, 3)
	hpFillCorner.Parent = hpFill

	local hpText = Instance.new("TextLabel")
	hpText.Name = "Value"
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.new(1, 0, 1, 0)
	hpText.Font = Enum.Font.GothamBold
	hpText.Text = string.format("%d / %d", humanoid.Health, humanoid.MaxHealth)
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextSize = isBoss and 10 or 8
	hpText.Parent = hpFrame

	humanoid.HealthChanged:Connect(function(health)
		local frac = math.clamp(health / math.max(1, humanoid.MaxHealth), 0, 1)
		hpFill.Size = UDim2.new(frac, 0, 1, 0)
		hpText.Text = string.format("%d / %d", math.max(0, math.floor(health)), humanoid.MaxHealth)
	end)

	return model
end

--------------------------------------------------------------------------------
-- Punch Combat Animation Function
--------------------------------------------------------------------------------
local function executePunchAnimation(model, isRightArm)
	local torso = model:FindFirstChild("Torso")
	if not torso then return end

	local shoulderName = isRightArm and "Right Shoulder" or "Left Shoulder"
	local shoulder = torso:FindFirstChild(shoulderName)
	if not shoulder or not shoulder:IsA("Motor6D") then return end

	local origC0 = shoulder.C0
	local sign = isRightArm and 1 or -1

	-- 1. Punch Strike Phase: Thrust arm forward and twist
	shoulder.C0 = origC0 * CFrame.Angles(math.rad(-85), math.rad(sign * 15), math.rad(sign * 10))

	-- Punch Impact VFX at hand
	local hand = model:FindFirstChild(isRightArm and "Right Arm" or "Left Arm")
	if hand then
		local pPart = Instance.new("Part")
		pPart.Size = Vector3.new(0.6, 0.6, 0.6)
		pPart.CFrame = hand.CFrame * CFrame.new(0, -1, 0)
		pPart.Transparency = 1
		pPart.CanCollide = false
		pPart.Anchored = true
		pPart.Parent = Workspace

		local punchEmitter = Instance.new("ParticleEmitter")
		punchEmitter.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 80, 20))
		punchEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		punchEmitter.Lifetime = NumberRange.new(0.2, 0.35)
		punchEmitter.Rate = 0
		punchEmitter.Speed = NumberRange.new(5, 12)
		punchEmitter.SpreadAngle = Vector2.new(180, 180)
		punchEmitter.Parent = pPart
		punchEmitter:Emit(15)

		Debris:AddItem(pPart, 0.4)
	end

	-- 2. Recoil Phase
	task.delay(0.12, function()
		if shoulder and shoulder.Parent then
			shoulder.C0 = origC0 * CFrame.Angles(math.rad(15), 0, math.rad(-sign * 5))
		end
	end)

	-- 3. Return to Idle
	task.delay(0.25, function()
		if shoulder and shoulder.Parent then
			shoulder.C0 = origC0
		end
	end)
end

--------------------------------------------------------------------------------
-- Drop Rolling Logic (Exact user specified percentages)
--------------------------------------------------------------------------------
local function rollBanditDrops(isBoss)
	local roll = math.random() * 100
	local droppedItem = nil

	if isBoss then
		-- Bandit Boss Drop:
		-- Lesser Qi Pill: 12%
		-- Helmet: 25%
		-- Armor: 25%
		-- No Item: 38%
		if roll <= 12 then
			droppedItem = "Lesser Qi Pill"
		elseif roll <= (12 + 25) then -- 37%
			droppedItem = "Helmet"
		elseif roll <= (12 + 25 + 25) then -- 62%
			droppedItem = "Armor"
		else
			droppedItem = nil -- 38% No Item
		end
		return 500, droppedItem
	else
		-- Regular Bandit Drop:
		-- 100 Gold guaranteed
		-- Lesser Qi Pill: 3%
		-- Helmet: 15%
		-- Armor: 12%
		-- No Item: 70%
		if roll <= 3 then
			droppedItem = "Lesser Qi Pill"
		elseif roll <= (3 + 15) then -- 18%
			droppedItem = "Helmet"
		elseif roll <= (3 + 15 + 12) then -- 30%
			droppedItem = "Armor"
		else
			droppedItem = nil -- 70% No Item
		end
		return 100, droppedItem
	end
end

--------------------------------------------------------------------------------
-- Floating 3D Loot Effect
--------------------------------------------------------------------------------
local function spawnLootPickup(position, goldAmount, itemName)
	local lootModel = Instance.new("Model")
	lootModel.Name = "LootDrop"

	-- Floating glowing coin / gem
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Cylinder
	core.Size = Vector3.new(0.4, 2, 2)
	core.CFrame = CFrame.new(position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	core.Color = itemName and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(255, 215, 60)
	core.Material = Enum.Material.Neon
	core.Anchored = true
	core.CanCollide = false
	core.Parent = lootModel

	local bbg = Instance.new("BillboardGui")
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 160, 0, 40)
	bbg.StudsOffset = Vector3.new(0, 1.8, 0)
	bbg.Adornee = core
	bbg.Parent = core

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.GothamBlack
	if itemName then
		label.Text = string.format("🪙 +%d Gold\n🎁 %s!", goldAmount, itemName)
		label.TextColor3 = Color3.fromRGB(255, 230, 80)
	else
		label.Text = string.format("🪙 +%d Gold", goldAmount)
		label.TextColor3 = Color3.fromRGB(255, 215, 50)
	end
	label.TextScaled = true
	label.Parent = bbg

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(20, 20, 20)
	stroke.Thickness = 1.5
	stroke.Parent = label

	lootModel.Parent = Workspace

	-- Animate floating up and spinning
	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < 3.5 and core.Parent do
			task.wait(0.03)
			local elapsed = tick() - t0
			core.CFrame = CFrame.new(position + Vector3.new(0, 1.5 + (elapsed * 0.6), 0)) * CFrame.Angles(0, elapsed * 3, math.rad(90))
		end
		lootModel:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Inventory Addition & Auto-Save Helper
--------------------------------------------------------------------------------
local function givePlayerDrop(player, goldAmount, itemName)
	local leaderstats = player:FindFirstChild("leaderstats")
	local gold = leaderstats and leaderstats:FindFirstChild("Gold")
	if gold then
		gold.Value = gold.Value + goldAmount
	end

	if itemName then
		local inv = player:FindFirstChild("Inventory")
		if not inv then
			inv = Instance.new("Folder")
			inv.Name = "Inventory"
			inv.Parent = player
		end

		local itemVal = inv:FindFirstChild(itemName)
		if not itemVal then
			itemVal = Instance.new("IntValue")
			itemVal.Name = itemName
			itemVal.Value = 0
			itemVal.Parent = inv
		end
		itemVal.Value = itemVal.Value + 1

		local notifMsg = string.format("🎁 LOOT DROP: Obtained %s! (+%d Gold)", itemName, goldAmount)
		cultivationRemote:FireClient(player, "Notification", notifMsg)
	else
		cultivationRemote:FireClient(player, "Notification", string.format("🪙 +%d Gold looted!", goldAmount))
	end
end

--------------------------------------------------------------------------------
-- Find Nearest Living Player
--------------------------------------------------------------------------------
local function findNearestLivingPlayer(rootPart, maxDist)
	local nearestHum, nearestRoot, minDist = nil, nil, maxDist or 60

	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local pRoot = char and char:FindFirstChild("HumanoidRootPart")

		if hum and pRoot and hum.Health > 0 then
			local dist = (pRoot.Position - rootPart.Position).Magnitude
			if dist <= minDist then
				nearestHum = hum
				nearestRoot = pRoot
				minDist = dist
			end
		end
	end

	return nearestHum, nearestRoot, minDist
end

--------------------------------------------------------------------------------
-- Spawn and Run an Enemy Unit (Bandit or Boss)
--------------------------------------------------------------------------------
local function spawnEnemy(name, spawnCF, isBoss)
	local scale = isBoss and 1.35 or 1.0
	local enemyModel = buildR6Rig(name, scale, isBoss)
	local hrp = enemyModel.PrimaryPart
	local humanoid = enemyModel:FindFirstChildOfClass("Humanoid")

	hrp.CFrame = spawnCF
	enemyModel.Parent = Workspace

	local baseDamage = isBoss and 24 or 12
	local attackCooldown = isBoss and 1.2 or 1.0
	local attackRange = 5 * scale
	local chaseRange = isBoss and 80 or 55
	local respawnDelay = isBoss and 60 or 10 -- 1 minute for boss, 10s for bandits

	local nextAttackTime = 0
	local punchSide = true
	local isDead = false

	-- Death Handler
	humanoid.Died:Connect(function()
		if isDead then return end
		isDead = true

		local deathPos = hrp.Position
		local gold, item = rollBanditDrops(isBoss)

		-- Find players who are close by to reward
		local rewardedPlayers = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local pRoot = char and char:FindFirstChild("HumanoidRootPart")
			if pRoot and (pRoot.Position - deathPos).Magnitude <= (isBoss and 80 or 45) then
				table.insert(rewardedPlayers, player)
			end
		end

		if #rewardedPlayers > 0 then
			for _, p in ipairs(rewardedPlayers) do
				givePlayerDrop(p, gold, item)
			end
		else
			-- Fallback: give to first active player if in server
			local first = Players:GetPlayers()[1]
			if first then
				givePlayerDrop(first, gold, item)
			end
		end

		-- Spawn 3D Floating Loot
		spawnLootPickup(deathPos, gold, item)

		if isBoss then
			for _, p in ipairs(Players:GetPlayers()) do
				cultivationRemote:FireClient(p, "Notification", "👑 Bandit Chieftain has fallen! Respawning in 1 minute...")
			end
		end

		-- Clean up dead model after 2 seconds
		task.delay(2, function()
			enemyModel:Destroy()
		end)

		-- Schedule Respawn
		task.delay(respawnDelay, function()
			spawnEnemy(name, spawnCF, isBoss)
		end)
	end)

	-- AI Combat & Punch Loop
	task.spawn(function()
		while not isDead and enemyModel.Parent and humanoid.Health > 0 do
			local targetHum, targetRoot, dist = findNearestLivingPlayer(hrp, chaseRange)

			if targetHum and targetRoot then
				humanoid:MoveTo(targetRoot.Position)

				-- Punch Attack Condition
				if dist <= attackRange and tick() >= nextAttackTime then
					nextAttackTime = tick() + attackCooldown
					punchSide = not punchSide
					executePunchAnimation(enemyModel, punchSide)

					-- Calculate Player Defense Reduction
					local targetChar = targetHum.Parent
					local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
					local playerDefense = targetPlayer and (targetPlayer:GetAttribute("Defense") or 0) or 0

					-- Defense absorbs damage! Minimum 1 damage
					local finalDamage = math.max(1, baseDamage - playerDefense)
					targetHum:TakeDamage(finalDamage)
				end
			else
				-- Return towards spawn if too far
				if (hrp.Position - spawnCF.Position).Magnitude > 35 then
					humanoid:MoveTo(spawnCF.Position)
				end
			end

			task.wait(0.25)
		end
	end)
end

--------------------------------------------------------------------------------
-- Initialization: Spawn Bandits & Boss across the Bandit Village
--------------------------------------------------------------------------------
function BanditManager.init()
	-- Bandit Village center is around CFrame.new(160, 0, -20)
	local centerPos = Vector3.new(160, 0, -20)

	-- 1. Spawn 4-5 Regular Bandits stationed in the camp
	local banditSpawnPositions = {
		centerPos + Vector3.new(-18, 3, 15),   -- Near Campfire West
		centerPos + Vector3.new(18, 3, 15),    -- Near Campfire East
		centerPos + Vector3.new(-22, 3, -12),  -- Near Western Tent
		centerPos + Vector3.new(22, 3, -12),   -- Near Eastern Tent
		centerPos + Vector3.new(0, 3, 34),     -- Guarding Front Gate
	}

	for i, pos in ipairs(banditSpawnPositions) do
		local spawnCF = CFrame.new(pos) * CFrame.Angles(0, math.rad(math.random(-180, 180)), 0)
		spawnEnemy("Bandit_" .. i, spawnCF, false)
	end

	-- 2. Spawn 1 Bandit Boss on the Chieftain Dais
	local bossSpawnCF = CFrame.new(centerPos + Vector3.new(0, 5.5, -38)) * CFrame.Angles(0, math.rad(180), 0)
	spawnEnemy("Bandit Chieftain", bossSpawnCF, true)

	print("⚔️ [BanditManager] Spawned 5 Bandits (10s respawn) and 1 Bandit Boss (1m respawn)!")
end

return BanditManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BanditVillage</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local BanditVillage = {}

--------------------------------------------------------------------------------
-- Color & Material Palette for Bandit Stronghold (黑风寨)
--------------------------------------------------------------------------------
local PALETTE = {
	DirtGround = Color3.fromRGB(56, 44, 34),
	DarkWood = Color3.fromRGB(52, 36, 26),
	RoughWood = Color3.fromRGB(78, 54, 38),
	SpikeWood = Color3.fromRGB(92, 65, 45),
	TentCloth = Color3.fromRGB(130, 40, 40),
	TentDark = Color3.fromRGB(35, 30, 32),
	Leather = Color3.fromRGB(115, 75, 45),
	StoneGrey = Color3.fromRGB(70, 72, 75),
	TorchFire = Color3.fromRGB(255, 140, 30),
	BloodRed = Color3.fromRGB(140, 20, 20),
	IronMetal = Color3.fromRGB(45, 48, 55),
	GoldTreasure = Color3.fromRGB(230, 185, 45),
}

local function makePart(parent, name, size, cframe, color, material)
	local p = Instance.new("Part")
	p.Name = name or "BanditPart"
	p.Size = size
	p.CFrame = cframe
	p.Color = color or PALETTE.RoughWood
	p.Material = material or Enum.Material.WoodPlanks
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeWedge(parent, name, size, cframe, color, material)
	local w = Instance.new("WedgePart")
	w.Name = name or "BanditWedge"
	w.Size = size
	w.CFrame = cframe
	w.Color = color or PALETTE.RoughWood
	w.Material = material or Enum.Material.WoodPlanks
	w.Anchored = true
	w.CanCollide = true
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Parent = parent
	return w
end

--------------------------------------------------------------------------------
-- Torch / Fire Brazier
--------------------------------------------------------------------------------
local function createBrazier(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "BanditTorch"

	-- Wooden Post
	makePart(model, "Post", Vector3.new(0.8, 5, 0.8), cframe * CFrame.new(0, 2.5, 0), PALETTE.DarkWood, Enum.Material.Wood)
	-- Iron Bowl
	local bowl = makePart(model, "Bowl", Vector3.new(2, 0.8, 2), cframe * CFrame.new(0, 5.2, 0), PALETTE.IronMetal, Enum.Material.CorrodedMetal)

	-- Fire Particle
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 80)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 20)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 20, 0))
	})
	fire.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.6, 1.6),
		NumberSequenceKeypoint.new(1, 0)
	})
	fire.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1)
	})
	fire.Lifetime = NumberRange.new(0.6, 1.2)
	fire.Rate = 22
	fire.Speed = NumberRange.new(3, 6)
	fire.SpreadAngle = Vector2.new(20, 20)
	fire.Acceleration = Vector3.new(0, 3, 0)
	fire.Parent = bowl

	-- Point Light
	local light = Instance.new("PointLight")
	light.Color = PALETTE.TorchFire
	light.Brightness = 3
	light.Range = 22
	light.Parent = bowl

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Watchtower (瞭望哨)
--------------------------------------------------------------------------------
local function createWatchtower(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "Watchtower"

	local towerHeight = 18

	-- 4 Main Stilts
	local offsets = {
		Vector3.new(-4, towerHeight / 2, -4),
		Vector3.new(4, towerHeight / 2, -4),
		Vector3.new(-4, towerHeight / 2, 4),
		Vector3.new(4, towerHeight / 2, 4),
	}
	for _, off in ipairs(offsets) do
		makePart(model, "Stilt", Vector3.new(1.4, towerHeight, 1.4), cframe * CFrame.new(off), PALETTE.DarkWood, Enum.Material.Wood)
	end

	-- Cross braces
	makePart(model, "Brace1", Vector3.new(9, 0.8, 0.8), cframe * CFrame.new(0, 8, -4), PALETTE.RoughWood)
	makePart(model, "Brace2", Vector3.new(9, 0.8, 0.8), cframe * CFrame.new(0, 8, 4), PALETTE.RoughWood)
	makePart(model, "Brace3", Vector3.new(0.8, 0.8, 9), cframe * CFrame.new(-4, 8, 0), PALETTE.RoughWood)
	makePart(model, "Brace4", Vector3.new(0.8, 0.8, 9), cframe * CFrame.new(4, 8, 0), PALETTE.RoughWood)

	-- Upper Guard Platform
	makePart(model, "Platform", Vector3.new(11, 1, 11), cframe * CFrame.new(0, towerHeight, 0), PALETTE.RoughWood, Enum.Material.WoodPlanks)

	-- Railings
	makePart(model, "RailF", Vector3.new(11, 2.5, 0.6), cframe * CFrame.new(0, towerHeight + 1.25, 5.2), PALETTE.DarkWood)
	makePart(model, "RailB", Vector3.new(11, 2.5, 0.6), cframe * CFrame.new(0, towerHeight + 1.25, -5.2), PALETTE.DarkWood)
	makePart(model, "RailL", Vector3.new(0.6, 2.5, 11), cframe * CFrame.new(-5.2, towerHeight + 1.25, 0), PALETTE.DarkWood)
	makePart(model, "RailR", Vector3.new(0.6, 2.5, 11), cframe * CFrame.new(5.2, towerHeight + 1.25, 0), PALETTE.DarkWood)

	-- Roof canopy on the tower
	makePart(model, "RoofPost1", Vector3.new(0.8, 6, 0.8), cframe * CFrame.new(-4.5, towerHeight + 3.5, -4.5), PALETTE.DarkWood)
	makePart(model, "RoofPost2", Vector3.new(0.8, 6, 0.8), cframe * CFrame.new(4.5, towerHeight + 3.5, -4.5), PALETTE.DarkWood)
	makePart(model, "RoofPost3", Vector3.new(0.8, 6, 0.8), cframe * CFrame.new(-4.5, towerHeight + 3.5, 4.5), PALETTE.DarkWood)
	makePart(model, "RoofPost4", Vector3.new(0.8, 6, 0.8), cframe * CFrame.new(4.5, towerHeight + 3.5, 4.5), PALETTE.DarkWood)
	makePart(model, "WatchRoof", Vector3.new(13, 0.8, 13), cframe * CFrame.new(0, towerHeight + 6.8, 0), PALETTE.TentCloth, Enum.Material.Fabric)

	-- Torch on platform
	createBrazier(model, cframe * CFrame.new(3.8, towerHeight + 0.5, 3.8))

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Bandit Tent (强盗帐篷)
--------------------------------------------------------------------------------
local function createBanditTent(parent, cframe, width, length)
	width = width or 14
	length = length or 16
	local height = 8

	local model = Instance.new("Model")
	model.Name = "BanditTent"

	-- Dirt / Hide Floor
	makePart(model, "Floor", Vector3.new(width, 0.4, length), cframe * CFrame.new(0, 0.2, 0), PALETTE.Leather, Enum.Material.Slate)

	-- Central Ridge Pole
	makePart(model, "RidgePole", Vector3.new(0.8, 0.8, length), cframe * CFrame.new(0, height, 0), PALETTE.DarkWood, Enum.Material.Wood)
	makePart(model, "FrontPost", Vector3.new(0.8, height, 0.8), cframe * CFrame.new(0, height / 2, length / 2), PALETTE.DarkWood, Enum.Material.Wood)
	makePart(model, "BackPost", Vector3.new(0.8, height, 0.8), cframe * CFrame.new(0, height / 2, -length / 2), PALETTE.DarkWood, Enum.Material.Wood)

	-- Left and Right slanted fabric roofs
	local slantAngle = math.rad(48)
	local roofWidth = math.sqrt((width / 2) ^ 2 + height ^ 2)

	local leftRoof = makePart(model, "RoofL", Vector3.new(roofWidth + 1, 0.5, length), cframe * CFrame.new(-width / 4, height / 2 + 0.5, 0) * CFrame.Angles(0, 0, -slantAngle), PALETTE.TentCloth, Enum.Material.Fabric)
	local rightRoof = makePart(model, "RoofR", Vector3.new(roofWidth + 1, 0.5, length), cframe * CFrame.new(width / 4, height / 2 + 0.5, 0) * CFrame.Angles(0, 0, slantAngle), PALETTE.TentDark, Enum.Material.Fabric)

	-- Weapon Rack or Loot Box inside tent
	local crate = makePart(model, "LootCrate", Vector3.new(2.8, 2.5, 2.8), cframe * CFrame.new(-2.2, 1.4, -2.5), PALETTE.RoughWood)
	local crateStripe = makePart(model, "CrateIron", Vector3.new(3, 0.4, 3), cframe * CFrame.new(-2.2, 1.4, -2.5), PALETTE.IronMetal, Enum.Material.Metal)

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Palisade Wall Segment with Spikes (木栅栏拒马)
--------------------------------------------------------------------------------
local function createPalisadeSegment(parent, cframe, length)
	length = length or 24
	local model = Instance.new("Model")
	model.Name = "PalisadeWall"

	local count = math.floor(length / 2)
	for i = 1, count do
		local x = -length / 2 + (i - 0.5) * 2
		local logH = 7.5 + (math.sin(i * 1.5) * 1.2)
		local log = makePart(model, "Log" .. i, Vector3.new(1.8, logH, 1.8), cframe * CFrame.new(x, logH / 2, 0), PALETTE.DarkWood, Enum.Material.Wood)

		-- Sharpened Spike on top
		local spike = makeWedge(model, "Spike" .. i, Vector3.new(1.8, 2, 1.8), cframe * CFrame.new(x, logH + 1, 0), PALETTE.SpikeWood, Enum.Material.Wood)
	end

	-- Horizontal binding logs
	makePart(model, "CrossbeamLower", Vector3.new(length, 0.8, 0.8), cframe * CFrame.new(0, 2.5, -1), PALETTE.RoughWood)
	makePart(model, "CrossbeamUpper", Vector3.new(length, 0.8, 0.8), cframe * CFrame.new(0, 6, -1), PALETTE.RoughWood)

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Stronghold Gate (山寨大门)
--------------------------------------------------------------------------------
local function createBanditGate(parent, cframe, width)
	width = width or 20
	local model = Instance.new("Model")
	model.Name = "BanditGate"

	local postH = 14
	-- 2 Giant Gate Posts
	makePart(model, "PostL", Vector3.new(2.4, postH, 2.4), cframe * CFrame.new(-width / 2, postH / 2, 0), PALETTE.DarkWood, Enum.Material.Wood)
	makePart(model, "PostR", Vector3.new(2.4, postH, 2.4), cframe * CFrame.new(width / 2, postH / 2, 0), PALETTE.DarkWood, Enum.Material.Wood)

	-- Top Heavy Cross Timber
	makePart(model, "TopTimber", Vector3.new(width + 4, 2, 2.4), cframe * CFrame.new(0, postH - 1, 0), PALETTE.RoughWood, Enum.Material.Wood)

	-- Spikes on Top
	for s = -4, 4 do
		makeWedge(model, "GateSpike", Vector3.new(1.5, 2.5, 1.5), cframe * CFrame.new(s * 2, postH + 1.2, 0), PALETTE.SpikeWood, Enum.Material.Wood)
	end

	-- Gate Banner / Sign: 黑风寨 (Black Wind Stronghold)
	local sign = makePart(model, "GateSign", Vector3.new(12, 2.8, 0.6), cframe * CFrame.new(0, postH - 3.5, 0), PALETTE.DarkWood)
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "GateLabel"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 220, 0, 48)
	bbg.Adornee = sign
	bbg.Parent = sign

	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.Font = Enum.Font.GothamBlack
	txt.Text = "☠ 黑 风 寨 ☠"
	txt.TextColor3 = Color3.fromRGB(255, 65, 65)
	txt.TextScaled = true
	txt.Parent = bbg

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(30, 10, 10)
	stroke.Thickness = 2
	stroke.Parent = txt

	-- Hanging Torches on both gate posts
	createBrazier(model, cframe * CFrame.new(-width / 2 - 2, 2, 1.5))
	createBrazier(model, cframe * CFrame.new(width / 2 + 2, 2, 1.5))

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Central Bonfire & Roasting Pit (山寨篝火)
--------------------------------------------------------------------------------
local function createCentralCampfire(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "BanditCampfire"

	-- Stone Fire Ring
	local stoneCount = 12
	local radius = 5
	for i = 1, stoneCount do
		local angle = (i / stoneCount) * math.pi * 2
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		local stone = makePart(model, "FireStone" .. i, Vector3.new(1.8, 1.2, 1.8), cframe * CFrame.new(x, 0.6, z), PALETTE.StoneGrey, Enum.Material.Slate)
	end

	-- Ash Bed
	makePart(model, "AshBed", Vector3.new(8, 0.4, 8), cframe * CFrame.new(0, 0.2, 0), Color3.fromRGB(30, 28, 28), Enum.Material.Basalt)

	-- Stacked Firewood Logs
	for rot = 0, 120, 60 do
		makePart(model, "Log" .. rot, Vector3.new(1.2, 1.2, 7), cframe * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, math.rad(rot), 0), PALETTE.DarkWood, Enum.Material.Wood)
	end

	-- Roaring Bonfire Center
	local firePart = makePart(model, "FireCore", Vector3.new(3, 2, 3), cframe * CFrame.new(0, 1.5, 0), PALETTE.TorchFire, Enum.Material.Neon)
	firePart.Transparency = 0.3
	firePart.CanCollide = false

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 150)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 120, 20)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 30, 0))
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(0.6, 3.5),
		NumberSequenceKeypoint.new(1, 0)
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.5),
		NumberSequenceKeypoint.new(1, 1)
	})
	emitter.Lifetime = NumberRange.new(0.8, 1.6)
	emitter.Rate = 50
	emitter.Speed = NumberRange.new(4, 9)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Acceleration = Vector3.new(0, 8, 0)
	emitter.Parent = firePart

	-- Smoke
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(70, 70, 75))
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.5),
		NumberSequenceKeypoint.new(1, 6)
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1)
	})
	smoke.Lifetime = NumberRange.new(2, 4)
	smoke.Rate = 14
	smoke.Speed = NumberRange.new(5, 10)
	smoke.SpreadAngle = Vector2.new(20, 20)
	smoke.Acceleration = Vector3.new(2, 6, 1)
	smoke.Parent = firePart

	-- Light
	local light = Instance.new("PointLight")
	light.Color = PALETTE.TorchFire
	light.Brightness = 5
	light.Range = 36
	light.Parent = firePart

	-- Surrounding Log Benches
	makePart(model, "Bench1", Vector3.new(8, 1.2, 1.6), cframe * CFrame.new(0, 0.6, -8), PALETTE.RoughWood, Enum.Material.Wood)
	makePart(model, "Bench2", Vector3.new(8, 1.2, 1.6), cframe * CFrame.new(0, 0.6, 8), PALETTE.RoughWood, Enum.Material.Wood)
	makePart(model, "Bench3", Vector3.new(1.6, 1.2, 8), cframe * CFrame.new(-8, 0.6, 0), PALETTE.RoughWood, Enum.Material.Wood)

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Bandit Chieftain Dais & Arena (大头目寨主宝座擂台)
--------------------------------------------------------------------------------
local function createChieftainDais(parent, cframe, size)
	size = size or Vector3.new(32, 2.5, 28)
	local model = Instance.new("Model")
	model.Name = "ChieftainDais"

	local sx = size.X
	local sy = size.Y
	local sz = size.Z

	-- Elevated Stone & Timber Platform
	makePart(model, "BasePlatform", Vector3.new(sx, sy, sz), cframe * CFrame.new(0, sy / 2, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)

	-- Front Steps
	local stepCount = 4
	for i = 1, stepCount do
		local depth = 1.8
		local h = (sy / stepCount) * i
		makePart(model, "Step" .. i, Vector3.new(sx * 0.45, sy / stepCount, depth), cframe * CFrame.new(0, h - (sy / stepCount / 2), (sz / 2) + (stepCount - i) * depth), PALETTE.RoughWood)
	end

	-- Chieftain's Throne (寨主铁木交椅)
	local throneY = sy + 0.2
	local throneCF = cframe * CFrame.new(0, throneY, -sz * 0.3)
	makePart(model, "ThroneSeat", Vector3.new(6, 1.4, 4), throneCF * CFrame.new(0, 0.7, 0), PALETTE.DarkWood, Enum.Material.Wood)
	makePart(model, "ThroneBack", Vector3.new(6, 7, 1.2), throneCF * CFrame.new(0, 4.2, -1.8), PALETTE.DarkWood, Enum.Material.Wood)
	makePart(model, "ThroneArmL", Vector3.new(1.2, 2.8, 4), throneCF * CFrame.new(-3.2, 1.8, 0), PALETTE.BloodRed)
	makePart(model, "ThroneArmR", Vector3.new(1.2, 2.8, 4), throneCF * CFrame.new(3.2, 1.8, 0), PALETTE.BloodRed)

	-- Tiger / Wolf Pelt on Throne
	makePart(model, "PeltBack", Vector3.new(4.8, 5, 0.4), throneCF * CFrame.new(0, 4, -1.2), PALETTE.GoldTreasure, Enum.Material.Fabric)

	-- 2 War Banners flanking the throne
	for _, xSign in ipairs({ -1, 1 }) do
		local bannerCF = cframe * CFrame.new(xSign * (sx * 0.38), sy, -sz * 0.3)
		makePart(model, "BannerPole", Vector3.new(0.8, 14, 0.8), bannerCF * CFrame.new(0, 7, 0), PALETTE.DarkWood, Enum.Material.Wood)
		local cloth = makePart(model, "BannerCloth", Vector3.new(4, 9, 0.2), bannerCF * CFrame.new(xSign * 2, 8, 0), PALETTE.BloodRed, Enum.Material.Fabric)

		local bbg = Instance.new("BillboardGui")
		bbg.AlwaysOnTop = true
		bbg.Size = UDim2.new(0, 80, 0, 100)
		bbg.Adornee = cloth
		bbg.Parent = cloth

		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.Font = Enum.Font.GothamBlack
		lbl.Text = "黑\n风"
		lbl.TextColor3 = Color3.fromRGB(255, 230, 80)
		lbl.TextScaled = true
		lbl.Parent = bbg
	end

	-- 4 Torch Braziers around the boss dais
	createBrazier(model, cframe * CFrame.new(-sx / 2 + 2, sy, -sz / 2 + 2))
	createBrazier(model, cframe * CFrame.new(sx / 2 - 2, sy, -sz / 2 + 2))
	createBrazier(model, cframe * CFrame.new(-sx / 2 + 2, sy, sz / 2 - 2))
	createBrazier(model, cframe * CFrame.new(sx / 2 - 2, sy, sz / 2 - 2))

	-- Gold Treasure Chests near the throne
	local chest1 = makePart(model, "Chest1", Vector3.new(3, 2, 2.2), throneCF * CFrame.new(-4.8, 1, 0.8) * CFrame.Angles(0, math.rad(25), 0), PALETTE.RoughWood)
	local chestLid1 = makePart(model, "ChestLid1", Vector3.new(3.2, 0.6, 2.4), chest1.CFrame * CFrame.new(0, 1.2, 0), PALETTE.GoldTreasure, Enum.Material.Metal)

	local chest2 = makePart(model, "Chest2", Vector3.new(3, 2, 2.2), throneCF * CFrame.new(4.8, 1, 0.8) * CFrame.Angles(0, math.rad(-20), 0), PALETTE.RoughWood)
	local chestLid2 = makePart(model, "ChestLid2", Vector3.new(3.2, 0.6, 2.4), chest2.CFrame * CFrame.new(0, 1.2, 0), PALETTE.GoldTreasure, Enum.Material.Metal)

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Main Generation
--------------------------------------------------------------------------------
function BanditVillage.generate()
	local existing = Workspace:FindFirstChild("BanditVillage")
	if existing then
		print("🏰 [BanditVillage] Bandit Village already exists in Workspace.")
		return existing
	end

	local villageFolder = Instance.new("Folder")
	villageFolder.Name = "BanditVillage"

	-- Position the Bandit Stronghold on the Eastern area of the map
	-- Baseplate is 512x512 (-256 to 256). Main village is around (0,0,0).
	-- Bandit camp sits at X: 160, Z: -20, nicely isolated but easily reachable!
	local centerCF = CFrame.new(160, 0, -20)
	local campW = 110
	local campL = 120

	-- 1. Dark Trampled Dirt / Gravel Ground for the camp
	local ground = makePart(villageFolder, "BanditCampGround", Vector3.new(campW, 0.6, campL), centerCF * CFrame.new(0, 0.1, 0), PALETTE.DirtGround, Enum.Material.Mud)

	-- 2. Perimeter Palisade Walls
	-- South Wall with Central Gate
	local gateW = 22
	local wallSectionW = (campW - gateW) / 2
	createPalisadeSegment(villageFolder, centerCF * CFrame.new(-campW / 2 + wallSectionW / 2, 0, campL / 2), wallSectionW)
	createPalisadeSegment(villageFolder, centerCF * CFrame.new(campW / 2 - wallSectionW / 2, 0, campL / 2), wallSectionW)
	createBanditGate(villageFolder, centerCF * CFrame.new(0, 0, campL / 2), gateW)

	-- North Wall (Back)
	createPalisadeSegment(villageFolder, centerCF * CFrame.new(0, 0, -campL / 2), campW)
	-- West Wall
	createPalisadeSegment(villageFolder, centerCF * CFrame.new(-campW / 2, 0, 0) * CFrame.Angles(0, math.rad(90), 0), campL)
	-- East Wall
	createPalisadeSegment(villageFolder, centerCF * CFrame.new(campW / 2, 0, 0) * CFrame.Angles(0, math.rad(90), 0), campL)

	-- 3. Twin Watchtowers flanking the gate
	createWatchtower(villageFolder, centerCF * CFrame.new(-gateW / 2 - 7, 0, campL / 2 - 6))
	createWatchtower(villageFolder, centerCF * CFrame.new(gateW / 2 + 7, 0, campL / 2 - 6))

	-- 4. Central Bonfire
	createCentralCampfire(villageFolder, centerCF * CFrame.new(0, 0, 10))

	-- 5. Outlaw Tents along the West and East flanks
	createBanditTent(villageFolder, centerCF * CFrame.new(-campW * 0.32, 0, -campL * 0.1) * CFrame.Angles(0, math.rad(90), 0), 14, 18)
	createBanditTent(villageFolder, centerCF * CFrame.new(-campW * 0.32, 0, campL * 0.2) * CFrame.Angles(0, math.rad(75), 0), 14, 16)
	createBanditTent(villageFolder, centerCF * CFrame.new(campW * 0.32, 0, -campL * 0.1) * CFrame.Angles(0, math.rad(-90), 0), 14, 18)
	createBanditTent(villageFolder, centerCF * CFrame.new(campW * 0.32, 0, campL * 0.2) * CFrame.Angles(0, math.rad(-75), 0), 14, 16)

	-- 6. Bandit Chieftain Dais at the North end
	createChieftainDais(villageFolder, centerCF * CFrame.new(0, 0, -campL * 0.32), Vector3.new(36, 2.5, 30))

	villageFolder.Parent = Workspace
	print("🏰 [BanditVillage] Generated Bandit Village at " .. tostring(centerCF.Position))
	return centerCF
end

return BanditVillage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DamageService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    DamageService.luau
    Central authority on the server for applying damage, verifying targets,
    checking Line of Sight, cultivating stat multipliers, and triggering drop rewards.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local DamageService = {}

-- Checks if an instance is a valid living target for damage
function DamageService.isValidTarget(targetHumanoid: Humanoid, casterPlayer: Player?): boolean
	if not targetHumanoid or targetHumanoid.Health <= 0 then
		return false
	end

	local targetModel = targetHumanoid.Parent
	if not targetModel or not targetModel:IsA("Model") then
		return false
	end

	-- Do not damage self
	if casterPlayer and casterPlayer.Character and targetModel == casterPlayer.Character then
		return false
	end

	return true
end

-- Checks if line of sight is clear between origin and target position
function DamageService.hasLineOfSight(origin: Vector3, targetPos: Vector3, ignoreList: { Instance }): boolean
	local direction = targetPos - origin
	local distance = direction.Magnitude
	if distance < 1 then
		return true
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignoreList
	rayParams.IgnoreWater = true

	local result = Workspace:Raycast(origin, direction.Unit * distance, rayParams)
	if result and result.Instance then
		-- If it hit non-collidable or translucent cosmetic parts, consider clear
		if not result.Instance.CanCollide or result.Instance.Transparency > 0.85 then
			return true
		end
		return false
	end
	return true
end

-- Gets a realm-based damage multiplier from player data if available
local function getRealmMultiplier(player: Player?): number
	if not player then return 1.0 end
	local data = player:FindFirstChild("CultivationData")
	if not data then return 1.0 end
	local realmVal = data:FindFirstChild("RealmIndex")
	if not realmVal then return 1.0 end
	-- Each realm adds 12% bonus damage
	return 1.0 + (realmVal.Value * 0.12)
end

-- Applies damage to a humanoid with realm scaling and defense reduction
function DamageService.applyDamage(
	targetHumanoid: Humanoid,
	baseDamage: number,
	casterPlayer: Player?,
	skillName: string?
): number
	if not DamageService.isValidTarget(targetHumanoid, casterPlayer) then
		return 0
	end

	local realmMult = getRealmMultiplier(casterPlayer)
	local finalDamage = math.floor(baseDamage * realmMult)

	-- Check for a defense attribute on the target's model
	local targetModel = targetHumanoid.Parent :: Model?
	if targetModel then
		local defAttr = targetModel:GetAttribute("Defense")
		if type(defAttr) == "number" and defAttr > 0 then
			finalDamage = math.max(1, finalDamage - defAttr)
		end
	end

	targetHumanoid:TakeDamage(finalDamage)

	if skillName then
		print(string.format("[DamageService] %s dealt %d damage via %s (realm mult: %.2f)",
			casterPlayer and casterPlayer.Name or "NPC",
			finalDamage, skillName, realmMult))
	end

	return finalDamage
end

-- Finds all humanoid targets within a sphere radius from a center point
function DamageService.findTargetsInRadius(
	center: Vector3,
	radius: number,
	casterPlayer: Player?,
	requireLoS: boolean?
): { Humanoid }
	local found: { Humanoid } = {}
	local ignoreList: { Instance } = {}

	if casterPlayer and casterPlayer.Character then
		table.insert(ignoreList, casterPlayer.Character)
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Humanoid") and obj.Health > 0 then
			local model = obj.Parent
			if model and model:IsA("Model") then
				-- Skip the caster's own character
				if casterPlayer and model == casterPlayer.Character then
					continue
				end

				local root = model:FindFirstChild("HumanoidRootPart")
					or model:FindFirstChild("Torso")
					or model:FindFirstChild("UpperTorso")
				if root and root:IsA("BasePart") then
					local dist = (root.Position - center).Magnitude
					if dist <= radius then
						if requireLoS then
							if DamageService.hasLineOfSight(center, root.Position, ignoreList) then
								table.insert(found, obj)
							end
						else
							table.insert(found, obj)
						end
					end
				end
			end
		end
	end

	return found
end

return DamageService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">SkillService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    SkillService.luau
    Authoritative server-side coordinator for the combat skill system:
    - Verifies player state (alive, not cultivating, valid character)
    - Validates equipped slots and ownership
    - Enforces server-side cooldown timers
    - Validates target distances, ranges, and Line of Sight
    - Executes authoritative hitboxes and projectile simulation
    - Deals scaled damage via DamageService
    - Replicates visual cues to all clients
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SkillConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SkillConfig"))
local DamageService = require(script.Parent:WaitForChild("DamageService"))

local SkillService = {}

-- Track cooldowns per player: [Player][skillName] = os.clock()
local playerCooldowns: { [Player]: { [string]: number } } = {}

-- Track equipped skills per player: [Player] = { [1] = "SkillA", [2] = "SkillB", ... }
local playerEquippedSkills: { [Player]: { [number]: string } } = {}

-- Remotes folder setup
local remotesFolder = ReplicatedStorage:FindFirstChild("SkillRemotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "SkillRemotes"
	remotesFolder.Parent = ReplicatedStorage
end

local skillRequestRemote = remotesFolder:FindFirstChild("SkillRequest")
if not skillRequestRemote then
	skillRequestRemote = Instance.new("RemoteEvent")
	skillRequestRemote.Name = "SkillRequest"
	skillRequestRemote.Parent = remotesFolder
end

local skillReplicateRemote = remotesFolder:FindFirstChild("SkillReplicate")
if not skillReplicateRemote then
	skillReplicateRemote = Instance.new("RemoteEvent")
	skillReplicateRemote.Name = "SkillReplicate"
	skillReplicateRemote.Parent = remotesFolder
end

local skillEquipRequestRemote = remotesFolder:FindFirstChild("SkillEquipRequest")
if not skillEquipRequestRemote then
	skillEquipRequestRemote = Instance.new("RemoteEvent")
	skillEquipRequestRemote.Name = "SkillEquipRequest"
	skillEquipRequestRemote.Parent = remotesFolder
end

local skillDataUpdateRemote = remotesFolder:FindFirstChild("SkillDataUpdate")
if not skillDataUpdateRemote then
	skillDataUpdateRemote = Instance.new("RemoteEvent")
	skillDataUpdateRemote.Name = "SkillDataUpdate"
	skillDataUpdateRemote.Parent = remotesFolder
end

-- Type casts to RemoteEvent since FindFirstChild returns Instance?
local skillRequest    = skillRequestRemote    :: RemoteEvent
local skillReplicate  = skillReplicateRemote  :: RemoteEvent
local skillEquipReq   = skillEquipRequestRemote :: RemoteEvent
local skillDataUpdate = skillDataUpdateRemote  :: RemoteEvent

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function getCharacterParts(player: Player): (Model?, BasePart?, Humanoid?)
	local char = player.Character
	if not char then return nil, nil, nil end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum  = char:FindFirstChildOfClass("Humanoid")
	return char, root, hum
end

local function isCooldownReady(player: Player, skillName: string): boolean
	local cd = playerCooldowns[player]
	if not cd then return true end
	local lastUsed = cd[skillName]
	if not lastUsed then return true end
	local skillDef = SkillConfig.Skills[skillName]
	if not skillDef then return true end
	return (os.clock() - lastUsed) >= skillDef.Cooldown
end

local function setCooldown(player: Player, skillName: string)
	if not playerCooldowns[player] then
		playerCooldowns[player] = {}
	end
	playerCooldowns[player][skillName] = os.clock()
end

local function getEquippedSkills(player: Player): { [number]: string }
	if not playerEquippedSkills[player] then
		-- Assign defaults
		local defaults: { [number]: string } = {}
		for i, name in ipairs(SkillConfig.DefaultSlots) do
			defaults[i] = name
		end
		playerEquippedSkills[player] = defaults
	end
	return playerEquippedSkills[player]
end

-- Exported so init.server can call it
function SkillService.getEquippedSkills(player: Player): { [number]: string }
	return getEquippedSkills(player)
end

--------------------------------------------------------------------------------
-- Skill Handlers (Server Authoritative)
--------------------------------------------------------------------------------

-- 1. Sword Slash — forward projectile hitbox simulation
local function handleSwordSlash(player: Player, skillDef: any, targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin = root.Position
	local aimDir: Vector3 = targetData.AimDirection or root.CFrame.LookVector
	if aimDir.Magnitude < 0.01 then aimDir = root.CFrame.LookVector end
	aimDir = aimDir.Unit

	local speed  = skillDef.ProjectileSpeed or 70
	local range  = skillDef.Range           or 25
	local radius = skillDef.Radius          or 4

	-- Server simulates projectile travel in steps
	local stepSize  = 3
	local steps     = math.ceil(range / stepSize)
	local hitModels: { [Model]: boolean } = {}

	local ignoreList: { Instance } = { char, Workspace.Terrain }

	task.spawn(function()
		for i = 1, steps do
			task.wait(stepSize / speed)
			local checkPos = origin + aimDir * (stepSize * i)

			local targets = DamageService.findTargetsInRadius(checkPos, radius, player, false)
			for _, hum2 in ipairs(targets) do
				local model = hum2.Parent :: Model
				if model and not hitModels[model] then
					hitModels[model] = true
					DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Sword Slash")
				end
			end
		end
	end)

	-- Replicate VFX to all clients
	skillReplicate:FireAllClients("SwordSlash", char, origin, aimDir, range, speed)
end

-- 2. Palm Art — area around caster AoE
local function handlePalmArt(player: Player, skillDef: any, _targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin  = root.Position
	local lookDir = root.CFrame.LookVector
	local radius  = skillDef.Radius or 14

	-- Small delay for cast animation
	task.wait(skillDef.CastTime or 0.4)

	local targets = DamageService.findTargetsInRadius(origin, radius, player, false)
	for _, hum2 in ipairs(targets) do
		DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Palm Art")
	end

	skillReplicate:FireAllClients("PalmArt", char, origin, lookDir, radius)
end

-- 3. Flame Ball — targeted AoE projectile
local function handleFlameBall(player: Player, skillDef: any, targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin    = root.Position
	local targetPos: Vector3 = targetData.TargetPosition or (origin + root.CFrame.LookVector * 30)
	local speed     = skillDef.ProjectileSpeed or 55
	local radius    = skillDef.Radius or 8

	-- Clamp target within range
	local toTarget = targetPos - origin
	if toTarget.Magnitude > skillDef.Range then
		targetPos = origin + toTarget.Unit * skillDef.Range
	end

	local travelTime = (targetPos - origin).Magnitude / speed

	task.spawn(function()
		task.wait(travelTime)
		-- Detonate at target
		local targets = DamageService.findTargetsInRadius(targetPos, radius, player, false)
		for _, hum2 in ipairs(targets) do
			DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Flame Ball")
		end
	end)

	skillReplicate:FireAllClients("FlameBall", char, origin, targetPos, speed, radius)
end

-- 4. Thunder Strike — sky AoE with warning
local function handleThunderStrike(player: Player, skillDef: any, targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin    = root.Position
	local targetPos: Vector3 = targetData.TargetPosition or (origin + root.CFrame.LookVector * 20)
	local radius    = skillDef.Radius          or 7
	local warning   = skillDef.WarningDuration or 1.5

	-- Clamp target within range
	local toTarget = targetPos - origin
	if toTarget.Magnitude > skillDef.Range then
		targetPos = origin + toTarget.Unit * skillDef.Range
	end

	-- Replicate warning ring first
	skillReplicate:FireAllClients("ThunderStrike", targetPos, radius, warning)

	task.spawn(function()
		task.wait(warning)
		-- Strike hits after warning
		local targets = DamageService.findTargetsInRadius(targetPos, radius, player, false)
		for _, hum2 in ipairs(targets) do
			DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Thunder Strike")
		end
	end)
end

-- 5. Multiple Swords — multi-projectile volley
local function handleMultipleSwords(player: Player, skillDef: any, targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin    = root.Position
	local targetPos: Vector3 = targetData.TargetPosition or (origin + root.CFrame.LookVector * 30)
	local count     = skillDef.ProjectileCount or 7
	local speed     = skillDef.ProjectileSpeed or 65
	local radius    = skillDef.Radius          or 5

	local toTarget   = targetPos - origin
	local travelDist = math.min(toTarget.Magnitude, skillDef.Range or 45)
	targetPos        = origin + toTarget.Unit * travelDist
	local travelTime = travelDist / speed

	local hitModels: { [Model]: boolean } = {}

	task.spawn(function()
		-- Stagger swords slightly
		for i = 1, count do
			task.wait(i * 0.08)
			task.spawn(function()
				task.wait(travelTime)
				-- Each sword hits independently
				local jitter = Vector3.new(
					math.random(-3, 3),
					math.random(-1, 1),
					math.random(-3, 3)
				)
				local impactPos = targetPos + jitter
				local targets = DamageService.findTargetsInRadius(impactPos, radius, player, false)
				for _, hum2 in ipairs(targets) do
					local model = hum2.Parent :: Model
					if model and not hitModels[model] then
						hitModels[model] = true
						DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Multiple Swords")
					end
				end
			end)
		end
	end)

	skillReplicate:FireAllClients("MultipleSwords", char, origin, targetPos, count, speed)
end

-- 6. Flame Spear — lock-on homing single target
local function handleFlameSpear(player: Player, skillDef: any, targetData: { [string]: any })
	local char, root, hum = getCharacterParts(player)
	if not char or not root or not hum or hum.Health <= 0 then return end

	local origin      = root.Position
	local targetModel = targetData.TargetModel :: Model?
	local targetPos: Vector3 = targetData.TargetPosition or (origin + root.CFrame.LookVector * 40)
	local speed       = skillDef.ProjectileSpeed or 80

	-- Validate target model is still alive and in range
	local finalTargetHum: Humanoid? = nil
	if targetModel and targetModel.Parent then
		local tHum = targetModel:FindFirstChildOfClass("Humanoid")
		local tRoot = targetModel:FindFirstChild("HumanoidRootPart")
			or targetModel:FindFirstChild("Torso")
		if tHum and tHum.Health > 0 and tRoot and tRoot:IsA("BasePart") then
			local dist = (tRoot.Position - origin).Magnitude
			if dist <= skillDef.Range then
				finalTargetHum = tHum
				targetPos = tRoot.Position
			end
		end
	end

	-- If no lock-on target, treat as straight shot to targetPos
	local toTarget   = targetPos - origin
	local travelDist = math.min(toTarget.Magnitude, skillDef.Range or 70)
	local travelTime = travelDist / speed

	task.spawn(function()
		task.wait(travelTime)
		if finalTargetHum then
			-- Re-validate at arrival
			if finalTargetHum.Health > 0 then
				DamageService.applyDamage(finalTargetHum, skillDef.BaseDamage, player, "Flame Spear")
			end
		else
			-- No lock-on, splash at position
			local impactPos = origin + toTarget.Unit * travelDist
			local targets = DamageService.findTargetsInRadius(impactPos, skillDef.Radius or 5, player, false)
			for _, hum2 in ipairs(targets) do
				DamageService.applyDamage(hum2, skillDef.BaseDamage, player, "Flame Spear")
			end
		end
	end)

	skillReplicate:FireAllClients("FlameSpear", char, origin, targetModel, targetPos, speed)
end

--------------------------------------------------------------------------------
-- Skill Dispatch Table
--------------------------------------------------------------------------------

local skillHandlers: { [string]: (Player, any, { [string]: any }) -> () } = {
	["Sword Slash"]    = handleSwordSlash,
	["Palm Art"]       = handlePalmArt,
	["Flame Ball"]     = handleFlameBall,
	["Thunder Strike"] = handleThunderStrike,
	["Multiple Swords"]= handleMultipleSwords,
	["Flame Spear"]    = handleFlameSpear,
}

--------------------------------------------------------------------------------
-- SkillService.init — call this from init.server.luau
--------------------------------------------------------------------------------
function SkillService.init()
	-- 1. Handle Skill Cast Requests from client
	skillRequest.OnServerEvent:Connect(function(player: Player, skillName: string, targetData: any)
		if type(skillName) ~= "string" then return end

		-- Validate skill exists
		local skillDef = SkillConfig.Skills[skillName]
		if not skillDef then
			warn("[SkillService] Unknown skill:", skillName)
			return
		end

		-- Validate skill is equipped in one of the player's slots
		local equipped = getEquippedSkills(player)
		local isEquipped = false
		for _, name in ipairs(equipped) do
			if name == skillName then
				isEquipped = true
				break
			end
		end
		if not isEquipped then
			warn("[SkillService] Player", player.Name, "tried to use unequipped skill:", skillName)
			return
		end

		-- Check cooldown
		if not isCooldownReady(player, skillName) then
			return
		end

		-- Check character is alive
		local _, _, hum = getCharacterParts(player)
		if not hum or hum.Health <= 0 then return end

		-- Set cooldown and execute
		setCooldown(player, skillName)
		local handler = skillHandlers[skillName]
		if handler then
			task.spawn(handler, player, skillDef, targetData or {})
		end
	end)

	-- 2. Handle Equip Slot Changes from client
	skillEquipReq.OnServerEvent:Connect(function(player: Player, action: string, slot: number, skillName: string)
		if action == "EquipSlot" then
			if type(slot) ~= "number" or slot < 1 or slot > 4 then return end
			if type(skillName) ~= "string" then return end
			if not SkillConfig.Skills[skillName] and skillName ~= "" then return end

			local equipped = getEquippedSkills(player)
			equipped[slot] = skillName
			-- Sync back to client
			skillDataUpdate:FireClient(player, "SyncEquipped", equipped)

		elseif action == "UnequipSlot" then
			if type(slot) ~= "number" or slot < 1 or slot > 4 then return end
			local equipped = getEquippedSkills(player)
			equipped[slot] = ""
			skillDataUpdate:FireClient(player, "SyncEquipped", equipped)
		end
	end)

	-- 3. Clean up on player leave
	Players.PlayerRemoving:Connect(function(player: Player)
		playerCooldowns[player] = nil
		playerEquippedSkills[player] = nil
	end)

	-- 4. Sync equipped skills when player spawns
	Players.PlayerAdded:Connect(function(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			local slots = SkillService.getEquippedSkills(player)
			skillDataUpdate:FireClient(player, "SyncEquipped", slots)
		end)
	end)

	print("⚡ [SkillService] Initialized combat skill server listeners and validation.")
end

return SkillService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">VillageGenerator</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local VillageGenerator = {}

--------------------------------------------------------------------------------
-- Color & Material Palette for Chinese Cultivation (Xianxia)
--------------------------------------------------------------------------------
local PALETTE = {
	RedPillar = Color3.fromRGB(165, 38, 28),
	DarkWood = Color3.fromRGB(45, 32, 25),
	GoldRoof = Color3.fromRGB(225, 170, 45),
	JadeRoof = Color3.fromRGB(38, 105, 92),
	GreyRoof = Color3.fromRGB(75, 80, 88),
	WhiteWall = Color3.fromRGB(240, 235, 225),
	StoneFloor = Color3.fromRGB(120, 125, 135),
	DarkStone = Color3.fromRGB(70, 72, 78),
	Bronze = Color3.fromRGB(150, 105, 55),
	LanternGlow = Color3.fromRGB(255, 150, 40),
	Water = Color3.fromRGB(30, 140, 180),
	PeachPink = Color3.fromRGB(255, 160, 195),
	BambooGreen = Color3.fromRGB(75, 140, 50)
}

--------------------------------------------------------------------------------
-- Builder Helper Functions
--------------------------------------------------------------------------------
local function makePart(parent, name, size, cframe, color, material)
	local p = Instance.new("Part")
	p.Name = name or "Part"
	p.Size = size
	p.CFrame = cframe
	p.Color = color or PALETTE.StoneFloor
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeWedge(parent, name, size, cframe, color, material)
	local w = Instance.new("WedgePart")
	w.Name = name or "Wedge"
	w.Size = size
	w.CFrame = cframe
	w.Color = color or PALETTE.GoldRoof
	w.Material = material or Enum.Material.SmoothPlastic
	w.Anchored = true
	w.CanCollide = true
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Parent = parent
	return w
end

--------------------------------------------------------------------------------
-- Street Lantern (石灯笼)
--------------------------------------------------------------------------------
local function createStoneLantern(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "StoneLantern"

	-- Base
	makePart(model, "Base", Vector3.new(2, 0.6, 2), cframe * CFrame.new(0, 0.3, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	-- Pillar
	makePart(model, "Pillar", Vector3.new(1, 3, 1), cframe * CFrame.new(0, 2.1, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	-- Housing Platform
	makePart(model, "Platform", Vector3.new(2.2, 0.4, 2.2), cframe * CFrame.new(0, 3.8, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- Glowing Core
	local core = makePart(model, "GlowCore", Vector3.new(1.2, 1.4, 1.2), cframe * CFrame.new(0, 4.7, 0), PALETTE.LanternGlow, Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = PALETTE.LanternGlow
	light.Brightness = 2.5
	light.Range = 18
	light.Parent = core

	-- Lantern Roof Cap
	makePart(model, "RoofCap", Vector3.new(2.8, 0.5, 2.8), cframe * CFrame.new(0, 5.6, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)
	makePart(model, "RoofFinial", Vector3.new(0.6, 0.8, 0.6), cframe * CFrame.new(0, 6.2, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Peach Blossom Tree (桃花树)
--------------------------------------------------------------------------------
local function createPeachBlossomTree(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "PeachBlossomTree"

	-- Trunk segments
	local t1 = makePart(model, "Trunk1", Vector3.new(1.6, 6, 1.6), cframe * CFrame.new(0, 3, 0) * CFrame.Angles(math.rad(4), 0, math.rad(-3)), PALETTE.DarkWood, Enum.Material.Wood)
	local t2 = makePart(model, "Trunk2", Vector3.new(1.3, 5, 1.3), cframe * CFrame.new(-0.4, 7, 0.2) * CFrame.Angles(math.rad(-10), math.rad(15), math.rad(12)), PALETTE.DarkWood, Enum.Material.Wood)
	local t3 = makePart(model, "Branch", Vector3.new(1, 4, 1), cframe * CFrame.new(0.8, 8, -0.4) * CFrame.Angles(math.rad(14), math.rad(-25), math.rad(-18)), PALETTE.DarkWood, Enum.Material.Wood)

	-- Pink foliage spheres
	local foliagePositions = {
		Vector3.new(-0.8, 10, 0.5),
		Vector3.new(1.4, 10.5, -0.6),
		Vector3.new(0, 11.5, 0),
		Vector3.new(-1.8, 9, 1.2),
		Vector3.new(1.8, 9.2, 0.8)
	}

	for idx, offset in ipairs(foliagePositions) do
		local f = Instance.new("Part")
		f.Name = "Blossoms" .. idx
		f.Shape = Enum.PartType.Ball
		f.Size = Vector3.new(5.5, 4.5, 5.5)
		f.CFrame = cframe * CFrame.new(offset)
		f.Color = PALETTE.PeachPink
		f.Material = Enum.Material.Grass
		f.Anchored = true
		f.CanCollide = false
		f.Parent = model
	end

	-- Falling Petal Emitter
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "PetalEmitterPart"
	emitterPart.Size = Vector3.new(2, 0.2, 2)
	emitterPart.CFrame = cframe * CFrame.new(0, 10, 0)
	emitterPart.Transparency = 1
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.Parent = model

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(PALETTE.PeachPink)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 0.3)
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.8, 0.4),
		NumberSequenceKeypoint.new(1, 1)
	})
	emitter.Lifetime = NumberRange.new(3, 5)
	emitter.Rate = 4
	emitter.Speed = NumberRange.new(1, 2.5)
	emitter.SpreadAngle = Vector2.new(45, 180)
	emitter.Acceleration = Vector3.new(1.5, -3, 0.8)
	emitter.Parent = emitterPart

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Bamboo Cluster (青竹林)
--------------------------------------------------------------------------------
local function createBambooCluster(parent, cframe)
	local model = Instance.new("Model")
	model.Name = "BambooCluster"

	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(1.2, 0, 0.8),
		Vector3.new(-1, 0, 1),
		Vector3.new(0.8, 0, -1.2),
		Vector3.new(-0.7, 0, -0.9)
	}

	for _, off in ipairs(offsets) do
		local height = math.random(11, 15)
		local stalk = Instance.new("Part")
		stalk.Name = "Stalk"
		stalk.Shape = Enum.PartType.Cylinder
		stalk.Size = Vector3.new(height, 0.5, 0.5)
		stalk.CFrame = cframe * CFrame.new(off) * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		stalk.Color = PALETTE.BambooGreen
		stalk.Material = Enum.Material.SmoothPlastic
		stalk.Anchored = true
		stalk.Parent = model

		local leaves = Instance.new("Part")
		leaves.Name = "Leaves"
		leaves.Shape = Enum.PartType.Ball
		leaves.Size = Vector3.new(3, 4, 3)
		leaves.CFrame = cframe * CFrame.new(off) * CFrame.new(0, height + 1, 0)
		leaves.Color = PALETTE.BambooGreen
		leaves.Material = Enum.Material.Grass
		leaves.Anchored = true
		leaves.CanCollide = false
		leaves.Parent = model
	end

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Paifang Mountain Gate (仙缘牌坊 / 山门)
--------------------------------------------------------------------------------
local function createPaifangGate(parent, cframe, width)
	width = width or 28
	local height = 18
	local model = Instance.new("Model")
	model.Name = "PaifangGate"

	-- 2 Main Stone Bases
	local colX = width * 0.35
	makePart(model, "PedestalL", Vector3.new(3.5, 2, 3.5), cframe * CFrame.new(-colX, 1, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "PedestalR", Vector3.new(3.5, 2, 3.5), cframe * CFrame.new(colX, 1, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- 2 Outer Pedestals
	local outX = width * 0.48
	makePart(model, "PedestalOutL", Vector3.new(2.8, 1.5, 2.8), cframe * CFrame.new(-outX, 0.75, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "PedestalOutR", Vector3.new(2.8, 1.5, 2.8), cframe * CFrame.new(outX, 0.75, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- 4 Vermilion Columns
	makePart(model, "ColMainL", Vector3.new(2, height, 2), cframe * CFrame.new(-colX, height / 2 + 2, 0), PALETTE.RedPillar, Enum.Material.WoodPlanks)
	makePart(model, "ColMainR", Vector3.new(2, height, 2), cframe * CFrame.new(colX, height / 2 + 2, 0), PALETTE.RedPillar, Enum.Material.WoodPlanks)
	makePart(model, "ColOutL", Vector3.new(1.6, height * 0.75, 1.6), cframe * CFrame.new(-outX, (height * 0.75) / 2 + 1.5, 0), PALETTE.RedPillar, Enum.Material.WoodPlanks)
	makePart(model, "ColOutR", Vector3.new(1.6, height * 0.75, 1.6), cframe * CFrame.new(outX, (height * 0.75) / 2 + 1.5, 0), PALETTE.RedPillar, Enum.Material.WoodPlanks)

	-- Main Crossbeam & Sub Beams
	makePart(model, "MainBeam", Vector3.new(width * 0.8, 1.8, 2.4), cframe * CFrame.new(0, height + 0.5, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)
	makePart(model, "LowerBeam", Vector3.new(width * 0.76, 1.2, 1.8), cframe * CFrame.new(0, height - 3.5, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)

	-- Calligraphy Plaque
	local plaque = makePart(model, "Plaque", Vector3.new(width * 0.45, 2.8, 0.6), cframe * CFrame.new(0, height - 1.5, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "Sign"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 260, 0, 50)
	bbg.Adornee = plaque
	bbg.Parent = plaque

	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.Font = Enum.Font.GothamBlack
	txt.Text = "仙 缘 古 镇"
	txt.TextColor3 = PALETTE.GoldRoof
	txt.TextScaled = true
	txt.Parent = bbg

	-- Curved Tiled Pagoda Roof
	local roofWidth = width * 0.95
	makePart(model, "RoofMain", Vector3.new(roofWidth, 1, 7), cframe * CFrame.new(0, height + 2, 0), PALETTE.JadeRoof, Enum.Material.SmoothPlastic)
	makePart(model, "RoofRidge", Vector3.new(roofWidth + 2, 1.2, 1.5), cframe * CFrame.new(0, height + 2.8, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)

	-- Upturned Eaves on Left and Right
	makeWedge(model, "EaveL", Vector3.new(3, 1.4, 7), cframe * CFrame.new(-roofWidth / 2 - 1, height + 2.5, 0) * CFrame.Angles(0, math.rad(90), math.rad(15)), PALETTE.GoldRoof)
	makeWedge(model, "EaveR", Vector3.new(3, 1.4, 7), cframe * CFrame.new(roofWidth / 2 + 1, height + 2.5, 0) * CFrame.Angles(0, math.rad(-90), math.rad(15)), PALETTE.GoldRoof)

	-- 2 Hanging Red Lanterns
	for _, xSide in ipairs({ -colX + 3, colX - 3 }) do
		local lantern = makePart(model, "Lantern", Vector3.new(1.4, 2, 1.4), cframe * CFrame.new(xSide, height - 4.5, 0), PALETTE.LanternGlow, Enum.Material.Neon)
		local lgt = Instance.new("PointLight")
		lgt.Color = PALETTE.LanternGlow
		lgt.Brightness = 3
		lgt.Range = 16
		lgt.Parent = lantern
	end

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Grand Sect Cultivation Pavilion / Main Hall (宗门大殿)
--------------------------------------------------------------------------------
local function createGrandSectPavilion(parent, cframe, size)
	size = size or Vector3.new(48, 26, 38)
	local model = Instance.new("Model")
	model.Name = "GrandSectPavilion"

	local sx = size.X
	local sy = size.Y
	local sz = size.Z

	-- 1. Grand Elevated Stone Foundation
	local baseHeight = 3.5
	makePart(model, "BaseDais", Vector3.new(sx + 8, baseHeight, sz + 8), cframe * CFrame.new(0, baseHeight / 2, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "UpperDais", Vector3.new(sx + 4, 1, sz + 4), cframe * CFrame.new(0, baseHeight + 0.5, 0), PALETTE.StoneFloor, Enum.Material.Granite)

	-- Grand Entrance Steps in Front
	local stepCount = 6
	for i = 1, stepCount do
		local stepDepth = 1.6
		local stepY = (baseHeight / stepCount) * i
		makePart(model, "Step" .. i, Vector3.new(sx * 0.45, baseHeight / stepCount, stepDepth), cframe * CFrame.new(0, stepY - (baseHeight / stepCount / 2), (sz / 2 + 4) + (stepCount - i) * stepDepth), PALETTE.StoneFloor, Enum.Material.Cobblestone)
	end

	-- 2. Enclosed Walls
	local wallY = baseHeight + 1 + (sy * 0.4) / 2
	local wallH = sy * 0.4
	makePart(model, "BackWall", Vector3.new(sx - 2, wallH, 1.5), cframe * CFrame.new(0, wallY, -sz / 2 + 1), PALETTE.WhiteWall, Enum.Material.SmoothPlastic)
	makePart(model, "LeftWall", Vector3.new(1.5, wallH, sz - 2), cframe * CFrame.new(-sx / 2 + 1, wallY, 0), PALETTE.WhiteWall, Enum.Material.SmoothPlastic)
	makePart(model, "RightWall", Vector3.new(1.5, wallH, sz - 2), cframe * CFrame.new(sx / 2 - 1, wallY, 0), PALETTE.WhiteWall, Enum.Material.SmoothPlastic)

	-- Front Wall with Grand Entrance Opening
	local doorOpening = sx * 0.35
	local sideWallW = (sx - doorOpening) / 2
	makePart(model, "FrontWallL", Vector3.new(sideWallW, wallH, 1.5), cframe * CFrame.new(-sx / 2 + sideWallW / 2, wallY, sz / 2 - 1), PALETTE.WhiteWall, Enum.Material.SmoothPlastic)
	makePart(model, "FrontWallR", Vector3.new(sideWallW, wallH, 1.5), cframe * CFrame.new(sx / 2 - sideWallW / 2, wallY, sz / 2 - 1), PALETTE.WhiteWall, Enum.Material.SmoothPlastic)

	-- 3. Vermilion Pillars (Colonnade)
	local colH = sy * 0.75
	local colY = baseHeight + 1 + colH / 2
	local colXOffsets = { -sx / 2 + 2, -sx * 0.2, sx * 0.2, sx / 2 - 2 }
	local colZOffsets = { -sz / 2 + 2, sz / 2 - 2 }

	for _, cx in ipairs(colXOffsets) do
		for _, cz in ipairs(colZOffsets) do
			makePart(model, "Pillar", Vector3.new(2, colH, 2), cframe * CFrame.new(cx, colY, cz), PALETTE.RedPillar, Enum.Material.WoodPlanks)
		end
	end

	-- 4. Tier 1 Pagoda Roof (Overhanging)
	local t1Y = baseHeight + 1 + wallH + 1
	makePart(model, "RoofTier1", Vector3.new(sx + 10, 1.5, sz + 10), cframe * CFrame.new(0, t1Y, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)

	-- 5. Tier 2 Upper Pavilion Story
	local upperH = sy * 0.35
	local upperY = t1Y + 1 + upperH / 2
	makePart(model, "UpperHall", Vector3.new(sx * 0.65, upperH, sz * 0.65), cframe * CFrame.new(0, upperY, 0), PALETTE.DarkWood, Enum.Material.WoodPlanks)

	-- 6. Tier 2 Top Pagoda Roof with Golden Spire
	local t2Y = upperY + upperH / 2 + 1
	makePart(model, "RoofTier2", Vector3.new(sx * 0.85, 1.8, sz * 0.85), cframe * CFrame.new(0, t2Y, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)

	-- Central Golden Ridge Spire
	makePart(model, "GoldenSpire", Vector3.new(2, 6, 2), cframe * CFrame.new(0, t2Y + 4, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)
	local pearl = Instance.new("Part")
	pearl.Name = "SpiritOrb"
	pearl.Shape = Enum.PartType.Ball
	pearl.Size = Vector3.new(3, 3, 3)
	pearl.CFrame = cframe * CFrame.new(0, t2Y + 7.5, 0)
	pearl.Color = Color3.fromRGB(0, 235, 255)
	pearl.Material = Enum.Material.Neon
	pearl.Anchored = true
	pearl.Parent = model

	-- Plaque inside / above door
	local plaque = makePart(model, "HallPlaque", Vector3.new(12, 2.5, 0.5), cframe * CFrame.new(0, t1Y - 1.5, sz / 2 - 0.4), PALETTE.DarkWood)
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "HallSign"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 220, 0, 45)
	bbg.Adornee = plaque
	bbg.Parent = plaque

	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.Font = Enum.Font.GothamBlack
	txt.Text = "宗 门 大 殿"
	txt.TextColor3 = PALETTE.GoldRoof
	txt.TextScaled = true
	txt.Parent = bbg

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Pill Pavilion & Alchemy Furnace (炼丹阁与炼丹炉)
--------------------------------------------------------------------------------
local function createPillPavilion(parent, cframe, size)
	size = size or Vector3.new(26, 18, 26)
	local model = Instance.new("Model")
	model.Name = "PillPavilion"

	local sx = size.X
	local sy = size.Y
	local sz = size.Z

	-- Octagonal / Stone Base
	makePart(model, "PillBase", Vector3.new(sx, 1.5, sz), cframe * CFrame.new(0, 0.75, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- Open Pavilion Pillars
	local colH = sy * 0.7
	local colY = 1.5 + colH / 2
	local corners = {
		Vector3.new(-sx / 2 + 2, colY, -sz / 2 + 2),
		Vector3.new(sx / 2 - 2, colY, -sz / 2 + 2),
		Vector3.new(-sx / 2 + 2, colY, sz / 2 - 2),
		Vector3.new(sx / 2 - 2, colY, sz / 2 - 2),
		Vector3.new(0, colY, -sz / 2 + 2)
	}

	for _, pos in ipairs(corners) do
		makePart(model, "Pillar", Vector3.new(1.8, colH, 1.8), cframe * CFrame.new(pos), PALETTE.DarkWood, Enum.Material.WoodPlanks)
	end

	-- Jade Tiled Curved Roof
	local roofY = 1.5 + colH + 1.5
	makePart(model, "JadeRoof", Vector3.new(sx + 6, 2, sz + 6), cframe * CFrame.new(0, roofY, 0), PALETTE.JadeRoof, Enum.Material.SmoothPlastic)
	makePart(model, "RoofCap", Vector3.new(sx * 0.5, 1.5, sz * 0.5), cframe * CFrame.new(0, roofY + 1.8, 0), PALETTE.GoldRoof, Enum.Material.SmoothPlastic)

	-- Giant Bronze Alchemy Furnace (神农炼丹炉) in center
	local furnace = Instance.new("Part")
	furnace.Name = "AlchemyCauldron"
	furnace.Shape = Enum.PartType.Ball
	furnace.Size = Vector3.new(5.5, 5.5, 5.5)
	furnace.CFrame = cframe * CFrame.new(0, 4.2, 0)
	furnace.Color = PALETTE.Bronze
	furnace.Material = Enum.Material.CorrodedMetal
	furnace.Anchored = true
	furnace.Parent = model

	-- Furnace Legs
	makePart(model, "Leg1", Vector3.new(1, 2.5, 1), cframe * CFrame.new(-1.8, 1.8, -1.8) * CFrame.Angles(math.rad(15), 0, math.rad(-15)), PALETTE.Bronze)
	makePart(model, "Leg2", Vector3.new(1, 2.5, 1), cframe * CFrame.new(1.8, 1.8, -1.8) * CFrame.Angles(math.rad(15), 0, math.rad(15)), PALETTE.Bronze)
	makePart(model, "Leg3", Vector3.new(1, 2.5, 1), cframe * CFrame.new(0, 1.8, 2.2) * CFrame.Angles(math.rad(-20), 0, 0), PALETTE.Bronze)

	-- Mystical Purple / Golden Smoke Particles
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "SpiritualFireSmoke"
	smoke.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 235, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 70, 240)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 215, 60))
	})
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.6, 3),
		NumberSequenceKeypoint.new(1, 0)
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.7, 0.6),
		NumberSequenceKeypoint.new(1, 1)
	})
	smoke.Lifetime = NumberRange.new(1.5, 3)
	smoke.Rate = 18
	smoke.Speed = NumberRange.new(3, 7)
	smoke.SpreadAngle = Vector2.new(20, 20)
	smoke.Acceleration = Vector3.new(0, 4, 0)
	smoke.Parent = furnace

	-- Cauldron Glow
	local cl = Instance.new("PointLight")
	cl.Color = Color3.fromRGB(180, 80, 240)
	cl.Brightness = 4
	cl.Range = 22
	cl.Parent = furnace

	-- Sign
	local plaque = makePart(model, "Plaque", Vector3.new(8, 2, 0.4), cframe * CFrame.new(0, roofY - 1.2, sz / 2 + 1), PALETTE.DarkWood)
	local bbg = Instance.new("BillboardGui")
	bbg.Name = "Sign"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 180, 0, 40)
	bbg.Adornee = plaque
	bbg.Parent = plaque

	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.Font = Enum.Font.GothamBlack
	txt.Text = "炼 丹 阁"
	txt.TextColor3 = PALETTE.JadeRoof
	txt.TextScaled = true
	txt.Parent = bbg

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Lotus Pond & Moon Bridge (青莲灵池)
--------------------------------------------------------------------------------
local function createLotusPond(parent, cframe, size)
	size = size or Vector3.new(30, 2, 24)
	local model = Instance.new("Model")
	model.Name = "LotusPond"

	local sx = size.X
	local sz = size.Z

	-- Stone Rim
	local rimThickness = 1.5
	makePart(model, "RimN", Vector3.new(sx, 1.2, rimThickness), cframe * CFrame.new(0, 0.6, -sz / 2), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "RimS", Vector3.new(sx, 1.2, rimThickness), cframe * CFrame.new(0, 0.6, sz / 2), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "RimW", Vector3.new(rimThickness, 1.2, sz), cframe * CFrame.new(-sx / 2, 0.6, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
	makePart(model, "RimE", Vector3.new(rimThickness, 1.2, sz), cframe * CFrame.new(sx / 2, 0.6, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- Glowing Water
	local water = makePart(model, "WaterSurface", Vector3.new(sx - 2, 0.4, sz - 2), cframe * CFrame.new(0, 0.3, 0), PALETTE.Water, Enum.Material.Glass)
	water.Transparency = 0.35
	water.CanCollide = false

	-- Water Glow
	local wl = Instance.new("PointLight")
	wl.Color = Color3.fromRGB(0, 220, 255)
	wl.Brightness = 2
	wl.Range = 25
	wl.Parent = water

	-- Arched Wooden Moon Bridge crossing the pond
	local bridgeLen = sz + 2
	local segCount = 7
	for i = 1, segCount do
		local frac = (i - 1) / (segCount - 1)
		local zPos = -bridgeLen / 2 + frac * bridgeLen
		local archY = 0.8 + math.sin(frac * math.pi) * 2.2

		makePart(model, "BridgePlank" .. i, Vector3.new(4.5, 0.4, bridgeLen / segCount + 0.2), cframe * CFrame.new(0, archY, zPos), PALETTE.DarkWood, Enum.Material.WoodPlanks)
		-- Railing posts
		makePart(model, "RailL" .. i, Vector3.new(0.4, 1.8, 0.4), cframe * CFrame.new(-2.1, archY + 0.9, zPos), PALETTE.RedPillar)
		makePart(model, "RailR" .. i, Vector3.new(0.4, 1.8, 0.4), cframe * CFrame.new(2.1, archY + 0.9, zPos), PALETTE.RedPillar)
	end

	-- Water Lilies / Lotus Flowers
	local flowerOffsets = {
		Vector3.new(-6, 0.4, -4),
		Vector3.new(-8, 0.4, 5),
		Vector3.new(7, 0.4, -6),
		Vector3.new(8, 0.4, 4)
	}
	for idx, fOff in ipairs(flowerOffsets) do
		-- Green Lily Pad
		local pad = Instance.new("Part")
		pad.Name = "LilyPad" .. idx
		pad.Shape = Enum.PartType.Cylinder
		pad.Size = Vector3.new(0.1, 2.8, 2.8)
		pad.CFrame = cframe * CFrame.new(fOff) * CFrame.Angles(0, 0, math.rad(90))
		pad.Color = Color3.fromRGB(40, 140, 60)
		pad.Material = Enum.Material.Grass
		pad.Anchored = true
		pad.CanCollide = false
		pad.Parent = model

		-- Pink Lotus Flower
		local lotus = Instance.new("Part")
		lotus.Name = "LotusFlower" .. idx
		lotus.Shape = Enum.PartType.Ball
		lotus.Size = Vector3.new(1.2, 1, 1.2)
		lotus.CFrame = cframe * CFrame.new(fOff + Vector3.new(0, 0.4, 0))
		lotus.Color = PALETTE.PeachPink
		lotus.Material = Enum.Material.Neon
		lotus.Anchored = true
		lotus.CanCollide = false
		lotus.Parent = model
	end

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Village Siheyuan House / Residence (弟子居 / 瓦房)
--------------------------------------------------------------------------------
local function createVillageHouse(parent, cframe, width, depth)
	width = width or 20
	depth = depth or 18
	local height = 12
	local model = Instance.new("Model")
	model.Name = "VillageHouse"

	-- Stone Foundation
	makePart(model, "Foundation", Vector3.new(width + 1, 1, depth + 1), cframe * CFrame.new(0, 0.5, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)

	-- White Plaster Walls with Timber Corner Posts
	local wallH = height * 0.65
	local wallY = 1 + wallH / 2
	makePart(model, "BackWall", Vector3.new(width - 1, wallH, 1), cframe * CFrame.new(0, wallY, -depth / 2 + 0.5), PALETTE.WhiteWall)
	makePart(model, "LeftWall", Vector3.new(1, wallH, depth - 1), cframe * CFrame.new(-width / 2 + 0.5, wallY, 0), PALETTE.WhiteWall)
	makePart(model, "RightWall", Vector3.new(1, wallH, depth - 1), cframe * CFrame.new(width / 2 - 0.5, wallY, 0), PALETTE.WhiteWall)

	-- Front Wall with Doorway
	local doorW = 5
	local sideW = (width - doorW) / 2
	makePart(model, "FrontL", Vector3.new(sideW, wallH, 1), cframe * CFrame.new(-width / 2 + sideW / 2, wallY, depth / 2 - 0.5), PALETTE.WhiteWall)
	makePart(model, "FrontR", Vector3.new(sideW, wallH, 1), cframe * CFrame.new(width / 2 - sideW / 2, wallY, depth / 2 - 0.5), PALETTE.WhiteWall)
	makePart(model, "DoorFrame", Vector3.new(doorW, wallH * 0.25, 1.2), cframe * CFrame.new(0, 1 + wallH - (wallH * 0.125), depth / 2 - 0.5), PALETTE.DarkWood)

	-- Timber Corner Columns
	for _, xOff in ipairs({ -width / 2 + 0.6, width / 2 - 0.6 }) do
		for _, zOff in ipairs({ -depth / 2 + 0.6, depth / 2 - 0.6 }) do
			makePart(model, "TimberPost", Vector3.new(1.2, wallH + 0.5, 1.2), cframe * CFrame.new(xOff, wallY, zOff), PALETTE.DarkWood, Enum.Material.WoodPlanks)
		end
	end

	-- Slanted Tiled Roof
	local roofY = 1 + wallH + 1.2
	makePart(model, "TiledRoof", Vector3.new(width + 4, 1.4, depth + 4), cframe * CFrame.new(0, roofY, 0), PALETTE.GreyRoof, Enum.Material.Slate)
	makePart(model, "RoofRidge", Vector3.new(width + 5, 1, 1.2), cframe * CFrame.new(0, roofY + 1.2, 0), PALETTE.DarkWood)

	-- Hanging Entrance Lantern
	local lantern = makePart(model, "PorchLantern", Vector3.new(1, 1.4, 1), cframe * CFrame.new(0, wallH, depth / 2 + 1.2), PALETTE.LanternGlow, Enum.Material.Neon)
	local lgt = Instance.new("PointLight")
	lgt.Color = PALETTE.LanternGlow
	lgt.Brightness = 2
	lgt.Range = 12
	lgt.Parent = lantern

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Martial Arts Sparring Arena (演武场)
--------------------------------------------------------------------------------
local function createSparringArena(parent, cframe, size)
	size = size or Vector3.new(24, 1, 24)
	local model = Instance.new("Model")
	model.Name = "SparringArena"

	-- Octagonal or circular stone dais
	local dais = Instance.new("Part")
	dais.Name = "ArenaDais"
	dais.Shape = Enum.PartType.Cylinder
	dais.Size = Vector3.new(size.Y, size.X, size.Z)
	dais.CFrame = cframe * CFrame.new(0, size.Y / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	dais.Color = PALETTE.DarkStone
	dais.Material = Enum.Material.Cobblestone
	dais.Anchored = true
	dais.Parent = model

	-- Inner Yin-Yang / Cultivation Ring
	local ring = Instance.new("Part")
	ring.Name = "YinYangRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, size.X * 0.7, size.Z * 0.7)
	ring.CFrame = cframe * CFrame.new(0, size.Y + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = PALETTE.StoneFloor
	ring.Material = Enum.Material.Granite
	ring.Anchored = true
	ring.Parent = model

	-- 4 Boundary Torches
	local rad = size.X * 0.42
	local torchOffsets = {
		Vector3.new(rad, 0, 0),
		Vector3.new(-rad, 0, 0),
		Vector3.new(0, 0, rad),
		Vector3.new(0, 0, -rad)
	}

	for _, tOff in ipairs(torchOffsets) do
		makePart(model, "BrazierPost", Vector3.new(1, 4, 1), cframe * CFrame.new(tOff) * CFrame.new(0, 2, 0), PALETTE.DarkStone, Enum.Material.Cobblestone)
		local brazier = makePart(model, "BrazierBowl", Vector3.new(2, 0.8, 2), cframe * CFrame.new(tOff) * CFrame.new(0, 4.4, 0), PALETTE.Bronze)
		local fire = Instance.new("ParticleEmitter")
		fire.Color = ColorSequence.new(Color3.fromRGB(255, 180, 50))
		fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		fire.Lifetime = NumberRange.new(0.5, 1)
		fire.Rate = 15
		fire.Speed = NumberRange.new(2, 5)
		fire.SpreadAngle = Vector2.new(15, 15)
		fire.Parent = brazier

		local fl = Instance.new("PointLight")
		fl.Color = PALETTE.LanternGlow
		fl.Brightness = 3
		fl.Range = 16
		fl.Parent = brazier
	end

	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Main Village Generator Function
--------------------------------------------------------------------------------
function VillageGenerator.generate()
	-- 1. Find the target "Fantasy village" Part or Model in Workspace
	local targetPart = nil
	local targetModel = nil

	for _, child in ipairs(Workspace:GetDescendants()) do
		local lower = string.lower(child.Name)
		if lower == "fantasy village" or lower == "fantasyvillage" or (string.find(lower, "fantasy") and string.find(lower, "village")) then
			if child:IsA("BasePart") then
				targetPart = child
				break
			elseif child:IsA("Model") then
				targetModel = child
				targetPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
				if targetPart then break end
			end
		end
	end

	-- Extract dimensions
	local originCF = CFrame.new(0, 0, 0)
	local sizeX = 260
	local sizeZ = 260
	local topY = 0

	if targetPart then
		originCF = targetPart.CFrame
		sizeX = math.max(120, targetPart.Size.X)
		sizeZ = math.max(120, targetPart.Size.Z)
		topY = targetPart.Position.Y + (targetPart.Size.Y / 2)
		originCF = CFrame.new(targetPart.Position.X, topY, targetPart.Position.Z) * (originCF - originCF.Position)
	end

	-- Check if village already exists in Workspace (from edit mode)
	local existingVillage = Workspace:FindFirstChild("ChineseCultivationVillage")
	if existingVillage then
		print("🏛️ [VillageGenerator] Chinese Cultivation Village already exists in Workspace.")
		return existingVillage
	end

	local villageFolder = Instance.new("Folder")
	villageFolder.Name = "ChineseCultivationVillage"

	-- 2. Ancient Cobblestone Ground & Roads matching the part length
	local ground = makePart(villageFolder, "VillageGround", Vector3.new(sizeX, 1, sizeZ), originCF * CFrame.new(0, -0.5, 0), PALETTE.StoneFloor, Enum.Material.Cobblestone)

	-- Main Central Boulevard (Cobble / Stone Slab Avenue) running South to North
	local roadWidth = math.clamp(sizeX * 0.12, 14, 24)
	makePart(villageFolder, "MainAvenue", Vector3.new(roadWidth, 0.2, sizeZ * 0.95), originCF * CFrame.new(0, 0.1, 0), PALETTE.DarkStone, Enum.Material.Granite)

	-- Cross Avenue running East to West
	local crossRoadWidth = math.clamp(sizeZ * 0.1, 12, 20)
	makePart(villageFolder, "CrossAvenue", Vector3.new(sizeX * 0.9, 0.2, crossRoadWidth), originCF * CFrame.new(0, 0.12, 0), PALETTE.DarkStone, Enum.Material.Granite)

	-- 3. Landmark 1: Paifang Entrance Mountain Gate (South Edge)
	local gateZ = sizeZ * 0.44
	local gateWidth = math.clamp(sizeX * 0.18, 24, 36)
	createPaifangGate(villageFolder, originCF * CFrame.new(0, 0, gateZ), gateWidth)

	-- 4. Landmark 2: Grand Sect Cultivation Pavilion (North Focal Point)
	local pavilionZ = -sizeZ * 0.32
	local pavilionSize = Vector3.new(math.clamp(sizeX * 0.32, 45, 70), 28, math.clamp(sizeZ * 0.25, 36, 55))
	createGrandSectPavilion(villageFolder, originCF * CFrame.new(0, 0, pavilionZ), pavilionSize)

	-- 5. Landmark 3: Pill Refining Pavilion (North-West Quadrant, near Shop)
	local pillX = -sizeX * 0.3
	local pillZ = -sizeZ * 0.08
	createPillPavilion(villageFolder, originCF * CFrame.new(pillX, 0, pillZ) * CFrame.Angles(0, math.rad(45), 0))

	-- Relocate Shop Merchant into the Pill Courtyard if active
	local merchant = Workspace:FindFirstChild("ShopMerchant")
	local circle = Workspace:FindFirstChild("ShopCircle")
	if merchant and circle then
		local shopSpot = originCF * CFrame.new(pillX + 16, 0, pillZ + 4)
		merchant:SetPrimaryPartCFrame(shopSpot * CFrame.new(0, 3, 0))
		circle.CFrame = CFrame.new(shopSpot.Position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end

	-- 6. Landmark 4: Lotus Pond & Moon Bridge (North-East Quadrant)
	local pondX = sizeX * 0.28
	local pondZ = -sizeZ * 0.08
	createLotusPond(villageFolder, originCF * CFrame.new(pondX, 0, pondZ), Vector3.new(sizeX * 0.22, 2, sizeZ * 0.2))

	-- 7. Landmark 5: Martial Arts Sparring Arena (South-West Quadrant)
	local arenaX = -sizeX * 0.28
	local arenaZ = sizeZ * 0.24
	createSparringArena(villageFolder, originCF * CFrame.new(arenaX, 0, arenaZ), Vector3.new(28, 1.2, 28))

	-- 8. Village Residential Houses & Siheyuan along the streets
	local housePlots = {
		-- South-East Residential Cluster
		originCF * CFrame.new(sizeX * 0.26, 0, sizeZ * 0.22) * CFrame.Angles(0, math.rad(-90), 0),
		originCF * CFrame.new(sizeX * 0.34, 0, sizeZ * 0.36) * CFrame.Angles(0, math.rad(180), 0),
		-- West Side Courtyards
		originCF * CFrame.new(-sizeX * 0.34, 0, -sizeZ * 0.25) * CFrame.Angles(0, math.rad(90), 0),
		originCF * CFrame.new(-sizeX * 0.36, 0, sizeZ * 0.06) * CFrame.Angles(0, math.rad(90), 0),
		-- East Side Courtyards
		originCF * CFrame.new(sizeX * 0.36, 0, -sizeZ * 0.26) * CFrame.Angles(0, math.rad(-90), 0),
	}

	for _, plotCF in ipairs(housePlots) do
		createVillageHouse(villageFolder, plotCF, 22, 18)
	end



	-- 10. Street Lanterns lining the avenues
	local avenueLen = sizeZ * 0.85
	local lanternSpacing = 30
	for z = -avenueLen / 2 + 10, avenueLen / 2 - 10, lanternSpacing do
		createStoneLantern(villageFolder, originCF * CFrame.new(-roadWidth / 2 - 2, 0, z))
		createStoneLantern(villageFolder, originCF * CFrame.new(roadWidth / 2 + 2, 0, z))
	end

	-- 11. Scenic Peach Blossom Trees & Bamboo Groves
	local treeSpots = {
		originCF * CFrame.new(-roadWidth / 2 - 7, 0, gateZ - 8),
		originCF * CFrame.new(roadWidth / 2 + 7, 0, gateZ - 8),
		originCF * CFrame.new(pondX + 16, 0, pondZ - 8),
		originCF * CFrame.new(pondX - 16, 0, pondZ + 12),
		originCF * CFrame.new(pillX - 14, 0, pillZ + 12),
		originCF * CFrame.new(0, 0, 0) * CFrame.new(-roadWidth / 2 - 8, 0, -8),
		originCF * CFrame.new(0, 0, 0) * CFrame.new(roadWidth / 2 + 8, 0, -8),
		originCF * CFrame.new(sizeX * 0.42, 0, sizeZ * 0.42),
		originCF * CFrame.new(-sizeX * 0.42, 0, sizeZ * 0.42)
	}

	for _, spot in ipairs(treeSpots) do
		createPeachBlossomTree(villageFolder, spot)
	end

	local bambooSpots = {
		originCF * CFrame.new(pondX + 14, 0, pondZ + 10),
		originCF * CFrame.new(pillX - 14, 0, pillZ - 10),
		originCF * CFrame.new(-sizeX * 0.42, 0, -sizeZ * 0.42),
		originCF * CFrame.new(sizeX * 0.42, 0, -sizeZ * 0.42)
	}

	for _, spot in ipairs(bambooSpots) do
		createBambooCluster(villageFolder, spot)
	end

	villageFolder.Parent = Workspace
	print(string.format("✅ [VillageGenerator] Successfully generated Chinese Cultivation Village (Bounds: %d x %d studs) on '%s'!", sizeX, sizeZ, targetPart and targetPart.Name or "Default Space"))
	return villageFolder
end

return VillageGenerator
]]></string>
        </Properties>
      </Item>
    </Item>
