local romanNumerals = {
	[0] = "0",
	[1] = "I",
	[2] = "II",
	[3] = "III",
	[4] = "IV",
	[5] = "V",
	[6] = "VI",
	[7] = "VII",
	[8] = "VIII",
	[9] = "IX",
	[10] = "X",
}

local function toRoman(level)
	return romanNumerals[level] or tostring(level)
end

local function isTyping()
	return UserInputService:GetFocusedTextBox() ~= nil
end

